---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

const {
  titolo = 'AnalisiTennis - Il tennis letto nei numeri',
  descrizione = 'Analisi autoriali sulle partite di tennis più attese del circuito ATP, WTA e Challenger. Il tennis letto nei numeri, firmato dalla Redazione AnalisiTennis.',
  immagine,
  canonical,
  tipo = 'website',
  // i18n: lang della pagina ('it' default) e lista completa delle versioni
  // linguistiche [{lang, href}] (incluso se stessa) per hreflang reciproco.
  lang = 'it',
  alternates = []
} = Astro.props;
const ogLocale = lang === 'en' ? 'en_US' : 'it_IT';
const hreflangOf = (l) => (l === 'it' ? 'it-it' : l);
const xDefaultHref = (alternates.find(a => a.lang === 'it') || alternates[0] || {}).href;

// Astro con build.format: 'file' (default per Cloudflare Pages) genera
// pagine con estensione .html nel pathname. Google interpreta .html come
// URL diversa da quella pulita, e se Cloudflare serve entrambe le vede
// come duplicate con canonical che punta a una delle due.
// Strippiamo .html dal canonical cosi' punta sempre alla versione pulita
// che il server effettivamente serve agli utenti.
const cleanPathname = Astro.url.pathname.replace(/\.html$/, '');
const url = canonical || new URL(cleanPathname, Astro.site).href;
const ogImage = immagine
  ? (immagine.startsWith('http') ? immagine : new URL(immagine, Astro.site).href)
  : new URL('/og-default.png', Astro.site).href;

const siteOrg = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  '@id': 'https://analisitennis.it/#organization',
  name: 'AnalisiTennis',
  alternateName: 'Redazione AnalisiTennis',
  url: 'https://analisitennis.it',
  logo: {
    '@type': 'ImageObject',
    '@id': 'https://analisitennis.it/#logo',
    url: 'https://analisitennis.it/logo-schema.png',
    contentUrl: 'https://analisitennis.it/logo-schema.png',
    width: 400,
    height: 400,
    caption: 'AnalisiTennis'
  },
  image: {
    '@id': 'https://analisitennis.it/#logo'
  },
  description: 'Testata editoriale italiana di analisi tennis. Analisi autoriali quotidiane sui match ATP, WTA, Slam e Challenger.',
  slogan: 'Il tennis letto nei numeri',
  inLanguage: 'it-IT',
  knowsLanguage: 'it',
  foundingDate: '2026-10-23',
  // Competenza tematica: aiuta Google/AI a capire di cosa siamo autorevoli.
  knowsAbout: [
    'Tennis', 'ATP Tour', 'WTA Tour', 'Tornei del Grande Slam',
    'ATP Challenger Tour', 'Pronostici tennis', 'Analisi tennis'
  ],
  areaServed: { '@type': 'Country', name: 'Italia' },
  // Policy pubbliche: Google News, Google Discover e gli assistenti AI
  // leggono questi URL come segnali forti di autorevolezza (E-E-A-T). Puntano
  // alle pagine dove dichiariamo in chiaro linea editoriale, metodo di lavoro,
  // gestione delle correzioni e politica di proprieta'. Devono esistere.
  publishingPrinciples: 'https://analisitennis.it/chi-siamo',
  ethicsPolicy: 'https://analisitennis.it/chi-siamo',
  correctionsPolicy: 'https://analisitennis.it/chi-siamo',
  actionableFeedbackPolicy: 'https://analisitennis.it/chi-siamo',
  ownershipFundingInfo: 'https://analisitennis.it/chi-siamo',
  masthead: 'https://analisitennis.it/chi-siamo',
  missionCoveragePrioritiesPolicy: 'https://analisitennis.it/metodo',
  verificationFactCheckingPolicy: 'https://analisitennis.it/metodo',
  diversityPolicy: 'https://analisitennis.it/chi-siamo',
  email: 'redazione@analisitennis.it',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'editorial',
    email: 'redazione@analisitennis.it',
    availableLanguage: ['Italian']
  },
  sameAs: []
};

const siteWeb = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://analisitennis.it/#website',
  url: 'https://analisitennis.it',
  name: 'AnalisiTennis',
  description: 'Il tennis letto nei numeri',
  publisher: { '@id': 'https://analisitennis.it/#organization' },
  inLanguage: 'it-IT',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://analisitennis.it/?q={search_term_string}',
    'query-input': 'required name=search_term_string'
  }
};
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content="#0a0e14" />
  <meta name="color-scheme" content="light" />
  <title>{titolo}</title>
  <meta name="description" content={descrizione} />
  <link rel="canonical" href={url} />

  <!-- Robots espliciti: autorizziamo thumbnail grandi (Discover + Google News)
       e snippet piu' lunghi. max-video-preview per quando aggiungeremo video. -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="google-news-publication" content="AnalisiTennis" />

  <!-- Favicon multi-format -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content={tipo} />
  <meta property="og:title" content={titolo} />
  <meta property="og:description" content={descrizione} />
  <meta property="og:url" content={url} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:site_name" content="AnalisiTennis" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content="AnalisiTennis" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={titolo} />
  <meta name="twitter:description" content={descrizione} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Source+Serif+Pro:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title="AnalisiTennis" href="/rss.xml" />

  <!-- Hreflang: se la pagina ha versioni linguistiche (alternates) emette un
       set reciproco it<->en + x-default; altrimenti segnala solo l'italiano. -->
  {alternates.length > 0 ? (
    <>
      {alternates.map(a => (
        <link rel="alternate" hreflang={hreflangOf(a.lang)} href={a.href} />
      ))}
      {xDefaultHref && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}
    </>
  ) : (
    <>
      <link rel="alternate" hreflang={hreflangOf(lang)} href={url} />
      <link rel="alternate" hreflang="x-default" href={url} />
    </>
  )}

  <!-- Prefetch per performance Core Web Vitals -->
  <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

  <!-- Schema.org structured data globale -->
  <script type="application/ld+json" set:html={JSON.stringify(siteOrg)} />
  <script type="application/ld+json" set:html={JSON.stringify(siteWeb)} />

  <!-- Google tag (gtag.js) con Consent Mode default denied -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-QKPL7S0XZ2"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'analytics_storage': 'denied',
      'wait_for_update': 500
    });
    gtag('js', new Date());
    gtag('config', 'G-QKPL7S0XZ2', { 'anonymize_ip': true });
  </script>
</head>
<body>
  {lang === 'en' ? (
    <header class="en-chrome en-top">
      <div class="en-inner">
        <a href="/en" class="en-logo">AnalisiTennis</a>
        <a href={xDefaultHref || '/'} class="en-switch" hreflang="it-it" rel="alternate">Leggi in italiano</a>
      </div>
    </header>
  ) : (
    <Header />
  )}
  <main>
    <slot />
  </main>
  {lang === 'en' ? (
    <footer class="en-chrome en-bottom">
      <div class="en-inner">
        <p>AnalisiTennis: tennis read through the numbers. Editorial analysis of ATP and WTA players and matches.</p>
        <p><a href={xDefaultHref || '/'} hreflang="it-it" rel="alternate">Versione italiana</a></p>
      </div>
    </footer>
  ) : (
    <>
      <Footer />
      <CookieBanner />
    </>
  )}
</body>
</html>
{lang === 'en' && (
  <style is:global>
    .en-chrome { background: #0a0e14; color: #fff; }
    .en-chrome .en-inner { max-width: 1120px; margin: 0 auto; padding: 16px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .en-top .en-logo { color: #39d453; font-weight: 800; font-size: 1.2rem; text-decoration: none; letter-spacing: -0.5px; }
    .en-chrome .en-switch, .en-bottom a { color: #9fb0c3; text-decoration: none; font-size: 0.9rem; }
    .en-chrome .en-switch:hover, .en-bottom a:hover { color: #39d453; }
    .en-bottom { margin-top: 48px; }
    .en-bottom .en-inner { flex-direction: column; align-items: flex-start; gap: 6px; }
    .en-bottom p { margin: 0; color: #9fb0c3; font-size: 0.88rem; }
  </style>
)}
