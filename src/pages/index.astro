---
import Base from '../layouts/Base.astro';
import FormEmail from '../components/FormEmail.astro';
import { getCollection } from 'astro:content';
import { playerSlug, displayPlayerName } from '../lib/hubs.js';

const tutti = await getCollection('articoli', ({ data }) => data.pubblicato !== false);
// Tutti gli articoli (piu' recenti in alto). Lato pagina ne mostriamo un
// blocco; "Visualizza altro" rivela i piu' vecchi a blocchi successivi.
const articoli = tutti.sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf());
const BATCH = 12;

// Strip "match di oggi": conteggio dei match della data piu' recente in
// archivio, con link a /oggi. Segnale di freschezza in cima alla home.
const latestDate = articoli.length ? new Date(articoli[0].data.data).toISOString().split('T')[0] : null;
const oggiCount = latestDate
  ? articoli.filter(a => new Date(a.data.data).toISOString().split('T')[0] === latestDate).length
  : 0;
const oggiLabel = latestDate
  ? new Date(latestDate).toLocaleDateString('it-IT', { weekday: 'long', day: 'numeric', month: 'long' })
  : '';

// "I piu' cercati": link diretti dalla home (pagina piu' autorevole) ai profili
// dei big. Concentra l'equity di link interni sulle pagine che catturano le
// query a piu' alto volume (nomi giocatori = motore delle impressioni su GSC)
// e da' al lettore un accesso rapido. Solo profili ESISTENTI: niente 404.
const _profili = await getCollection('giocatori-profilo', ({ data }) => data.pubblicato !== false);
const _slugProfili = new Set(_profili.map(p => p.data.slug_profilo));
const piuCercatiCurati = [
  { nome: 'Jannik Sinner', slug: 'jannik-sinner' },
  { nome: 'Carlos Alcaraz', slug: 'carlos-alcaraz' },
  { nome: 'Lorenzo Musetti', slug: 'lorenzo-musetti' },
  { nome: 'Novak Djokovic', slug: 'novak-djokovic' },
  { nome: 'Matteo Berrettini', slug: 'matteo-berrettini' },
  { nome: 'Alexander Zverev', slug: 'alexander-zverev' },
  { nome: 'Aryna Sabalenka', slug: 'aryna-sabalenka' },
  { nome: 'Iga Swiatek', slug: 'iga-swiatek' },
  { nome: 'Coco Gauff', slug: 'coco-gauff' },
  { nome: 'Jasmine Paolini', slug: 'jasmine-paolini' },
  { nome: 'Elena Rybakina', slug: 'elena-rybakina' },
  { nome: 'Daniil Medvedev', slug: 'daniil-medvedev' },
];
// Protagonisti DEL MOMENTO: i giocatori piu' presenti nelle analisi recenti
// (ultimi 10 giorni) che hanno un profilo. Catturano i picchi di ricerca
// stagionali (es. un emergente che fa un grande torneo) e portano link interni
// dalla home proprio sulle pagine che in quel momento ricevono impressioni.
const curatiSlugs = new Set(piuCercatiCurati.map(p => p.slug));
const oraMs = latestDate ? new Date(latestDate).valueOf() : Date.now();
const freq = new Map();
for (const a of articoli) {
  if ((oraMs - new Date(a.data.data).valueOf()) > 10 * 86400000) continue;
  for (const g of [a.data.giocatore1, a.data.giocatore2]) {
    if (!g || g === 'Redazione' || g === 'Lettori') continue;
    const s = playerSlug(g);
    if (!_slugProfili.has(s) || curatiSlugs.has(s)) continue;
    const cur = freq.get(s) || { slug: s, nome: displayPlayerName(g), n: 0 };
    cur.n++; freq.set(s, cur);
  }
}
const delMomento = [...freq.values()].sort((a, b) => b.n - a.n).slice(0, 6);
const piuCercati = [
  ...delMomento,
  ...piuCercatiCurati.filter(p => _slugProfili.has(p.slug)),
].slice(0, 14);

// FAQ Page schema per rich snippet su query "analisitennis" o "come funziona analisitennis"
const faqHome = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Cosa è AnalisiTennis?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'AnalisiTennis è una testata editoriale italiana indipendente che pubblica analisi quotidiane sulle partite del circuito ATP, WTA, Slam e Challenger. Ogni articolo è firmato dalla Redazione e combina dati, scontri diretti, forma recente e letture tattiche per raccontare un match prima che sia giocato.'
      }
    },
    {
      '@type': 'Question',
      name: 'Quando pubblicate i pronostici?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Pubblichiamo le nostre analisi ogni mattina intorno alle ore 07:30, in modo da offrire la lettura dei match della giornata prima dei primi incontri. L\'orario di pubblicazione è visibile su ogni articolo.'
      }
    },
    {
      '@type': 'Question',
      name: 'Dove trovo i match analizzati oggi?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nella sezione "Oggi" del menu principale trovi la raccolta aggiornata di tutti i match analizzati nella giornata corrente. Puoi anche navigare per categoria (ATP, WTA, Slam, Challenger), per giocatore o per torneo.'
      }
    },
    {
      '@type': 'Question',
      name: 'I vostri pronostici sono scommesse?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. AnalisiTennis è una testata editoriale: pubblichiamo pronostici sportivi come fa qualunque giornale sportivo. Non trattiamo quote, non promuoviamo bookmaker, non diamo consigli di scommessa. Il nostro verdetto è una lettura autoriale del match.'
      }
    },
    {
      '@type': 'Question',
      name: 'Come posso ricevere le analisi via email?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nel modulo "Iscriviti al nostro blog" presente su ogni pagina lasci nome ed email. Riceverai una email ogni volta che pubblichiamo una nuova analisi. Niente spam, un click per disiscriverti.'
      }
    }
  ]
};
---
<Base
  titolo="AnalisiTennis - Il tennis letto nei numeri"
  descrizione="Analisi autoriali quotidiane sulle partite di tennis ATP, WTA, Slam e Challenger. Il tennis letto nei numeri, firmato dalla Redazione AnalisiTennis."
  immagine="/og-default.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqHome)} />

  <section class="homepage-hero">
    <h1>Il <span class="verde">tennis</span> letto nei numeri</h1>
    <p>Analisi autoriali quotidiane sulle partite piu' attese del circuito ATP, WTA e Challenger. Dati, contesto, letture tattiche.</p>
  </section>

  {oggiCount > 0 && (
    <div class="contenitore">
      <a class="oggi-strip" href="/oggi">
        <span class="oggi-strip-live"><span class="oggi-dot"></span>Oggi</span>
        <span class="oggi-strip-txt"><strong>{oggiCount} match analizzati</strong><span class="oggi-strip-data">{oggiLabel}</span></span>
        <span class="oggi-strip-cta">Vai ai match di oggi →</span>
      </a>
    </div>
  )}

  <div class="contenitore">
    <div class="layout-home">
      <div class="colonna-articoli">
        <h2 class="sezione-eyebrow">Ultime analisi</h2>
        <div class="griglia-articoli" id="home-griglia" data-batch={BATCH} style="padding: 0;">
          {articoli.map((art, i) => (
            <article class="card-articolo" hidden={i >= BATCH}>
              {art.data.cover_image && (
                <a class="card-cover" href={`/articoli/${art.slug}`} aria-label={art.data.titolo}>
                  <picture>
                    <source srcset={art.data.cover_image.replace(/\.jpg$/, '.webp')} type="image/webp" />
                    <img
                      src={art.data.cover_image}
                      alt={`${art.data.giocatore1} vs ${art.data.giocatore2} - ${art.data.torneo}`}
                      width="640"
                      height="360"
                      loading={i < 4 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </picture>
                </a>
              )}
              <div class="eyebrow">{art.data.categoria} - {art.data.torneo}</div>
              <h2><a href={`/articoli/${art.slug}`}>{art.data.titolo}</a></h2>
              <p class="sottotitolo">{art.data.sottotitolo}</p>
              <div class="data">
                {new Date(art.data.data).toLocaleDateString('it-IT', {
                  day: 'numeric', month: 'long', year: 'numeric'
                })}
              </div>
            </article>
          ))}
        </div>
        {articoli.length > BATCH && (
          <div class="home-piu-wrap">
            <button type="button" id="home-piu" class="home-piu">
              Visualizza altre analisi
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 5v14m0 0l-6-6m6 6l6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <p class="home-conteggio" id="home-conteggio"></p>
          </div>
        )}
      </div>
      <aside>
        <div class="side-sticky">
          <FormEmail />
          {piuCercati.length > 0 && (
            <nav class="piu-cercati" aria-label="Giocatori piu' cercati">
              <h2 class="sezione-eyebrow">I piu' cercati</h2>
              <ul>
                {piuCercati.map(p => (
                  <li><a href={`/giocatori/${p.slug}`}>{p.nome}</a></li>
                ))}
              </ul>
              <a class="piu-cercati-tutti" href="/giocatori">Tutti i giocatori →</a>
            </nav>
          )}
        </div>
      </aside>
    </div>
  </div>

  <script>
    // Home: rivela gli articoli piu' vecchi a blocchi. Tutte le card sono
    // gia' nel markup (bene per SEO), qui mostriamo solo il blocco corrente.
    (function () {
      const grid = document.getElementById('home-griglia');
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll('.card-articolo'));
      const btn = document.getElementById('home-piu');
      const conteggio = document.getElementById('home-conteggio');
      const BATCH = parseInt(grid.getAttribute('data-batch') || '12', 10);
      let mostrati = BATCH;

      function render() {
        cards.forEach(function (card, i) { card.hidden = i >= mostrati; });
        if (btn) {
          const restano = mostrati < cards.length;
          btn.hidden = !restano;
          if (btn.parentElement) btn.parentElement.hidden = cards.length <= BATCH;
          if (conteggio) conteggio.textContent = 'Mostrate ' + Math.min(mostrati, cards.length) + ' di ' + cards.length + ' analisi';
        }
      }
      if (btn) btn.addEventListener('click', function () { mostrati += BATCH; render(); });
      render();
    })();
  </script>
</Base>

<style>
  .home-piu-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin: 28px 0 40px;
  }
  .home-piu {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 26px;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--testo, #1a1a1a);
    background: var(--sfondo-card, #fff);
    border: 1px solid var(--linea, #d8dde3);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, transform 0.15s;
  }
  .home-piu:hover {
    border-color: var(--verde, #39d453);
    color: var(--verde, #2a7f3e);
    transform: translateY(-1px);
  }
  .home-piu svg { display: block; }
  .home-conteggio {
    font-size: 0.8rem;
    color: var(--testo-secondario, #8a94a3);
    margin: 0;
  }
  .oggi-strip {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 18px 0 4px;
    padding: 14px 20px;
    background: var(--sfondo-card, #fff);
    border: 1px solid var(--linea, #e5e5e5);
    border-left: 4px solid var(--verde, #39d453);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, transform 0.15s;
  }
  .oggi-strip:hover { border-color: var(--verde, #39d453); transform: translateY(-1px); }
  .oggi-strip-live {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: 0.72rem; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--verde, #2a7f3e);
  }
  .oggi-dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--verde, #39d453);
    box-shadow: 0 0 0 0 rgba(57, 212, 83, 0.5); animation: oggiPulse 2s infinite;
  }
  @keyframes oggiPulse {
    0% { box-shadow: 0 0 0 0 rgba(57, 212, 83, 0.5); }
    70% { box-shadow: 0 0 0 7px rgba(57, 212, 83, 0); }
    100% { box-shadow: 0 0 0 0 rgba(57, 212, 83, 0); }
  }
  .oggi-strip-txt { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .oggi-strip-txt strong { font-size: 1rem; color: var(--testo, #1a1a1a); }
  .oggi-strip-data { font-size: 0.8rem; color: var(--testo-secondario, #8a94a3); text-transform: capitalize; }
  .oggi-strip-cta { margin-left: auto; font-size: 0.9rem; font-weight: 700; color: var(--verde, #2a7f3e); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .oggi-dot { animation: none; } }

  .piu-cercati {
    margin-top: 20px;
    background: var(--sfondo-card, #fff);
    border: 1px solid var(--linea, #e5e5e5);
    border-radius: 12px;
    padding: 18px 20px;
  }
  .piu-cercati .sezione-eyebrow { margin: 0 0 12px; }
  .piu-cercati ul {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
    display: flex;
    flex-direction: column;
  }
  .piu-cercati li + li { border-top: 1px solid var(--linea, #eef1f4); }
  .piu-cercati li a {
    display: block;
    padding: 9px 0;
    color: var(--testo, #1a1a1a);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.15s;
  }
  .piu-cercati li a:hover { color: var(--verde, #2a7f3e); }
  .piu-cercati-tutti {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--verde, #2a7f3e);
    text-decoration: none;
  }
  .piu-cercati-tutti:hover { text-decoration: underline; }
</style>
