---
import Base from '../../layouts/Base.astro';
import FormEmail from '../../components/FormEmail.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { playerSlug, slugify, findRanking } from '../../lib/hubs.js';
import h2hData from '../../data/h2h.json';
import profilesEn from '../../data/profiles-en.json';
import standingsAtp from '../../data/standings-atp.json';
import standingsWta from '../../data/standings-wta.json';

export async function getStaticPaths() {
  const profili = await getCollection('giocatori-profilo', ({ data }) => data.pubblicato !== false);
  const articoli = await getCollection('articoli', ({ data }) => data.pubblicato !== false);
  // Mappa slug-da-nome-completo -> slug_profilo, per collegare le coppie h2h
  // (che usano gli slug a nome completo) ai profili (slug abbreviati).
  const fullSlugToProfile = {};
  for (const p of profili) fullSlugToProfile[slugify(p.data.nome)] = p.data.slug_profilo;
  return profili.map(p => {
    const slug = p.data.slug_profilo;
    const relatedArticles = articoli
      .filter(a => playerSlug(a.data.giocatore1) === slug || playerSlug(a.data.giocatore2) === slug)
      .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
      .slice(0, 20);
    // Scontri diretti del giocatore: ogni voce h2h che lo coinvolge diventa
    // un link alla pagina /scontri-diretti e, se esiste, al profilo avversario.
    const mySlug = slugify(p.data.nome);
    const h2hLinks = [];
    for (const [pairSlug, h] of Object.entries(h2hData)) {
      if (h.slug_p1 !== mySlug && h.slug_p2 !== mySlug) continue;
      const amP1 = h.slug_p1 === mySlug;
      const oppName = amP1 ? h.p2 : h.p1;
      const oppFullSlug = amP1 ? h.slug_p2 : h.slug_p1;
      const b = h.bilancio || {};
      const myWins = amP1 ? (b.p1 || 0) : (b.p2 || 0);
      const oppWins = amP1 ? (b.p2 || 0) : (b.p1 || 0);
      h2hLinks.push({
        pairSlug, oppName,
        oppProfile: fullSlugToProfile[oppFullSlug] || null,
        myWins, oppWins, tot: myWins + oppWins,
      });
    }
    h2hLinks.sort((a, b) => b.tot - a.tot || a.oppName.localeCompare(b.oppName));
    return { params: { slug }, props: { profilo: p, relatedArticles, h2hLinks } };
  });
}

const { profilo, relatedArticles, h2hLinks } = Astro.props;
const { Content } = await profilo.render();
const d = profilo.data;
const site = 'https://analisitennis.it';

// Ranking attuale del giocatore (se in top-100), per il banner e lo schema.
// Match robusto: tollera ordine nomi, cognomi multipli, accenti (vedi hubs.js).
const ranking = findRanking(d.nome, standingsAtp.righe, standingsWta.righe);
const rankingUrl = ranking ? (ranking.tour === 'ATP' ? '/classifica-atp' : '/classifica-wta') : null;
const rankingUpdated = ranking ? (ranking.tour === 'ATP' ? standingsAtp.aggiornato_il : standingsWta.aggiornato_il) : null;

// Eta' corrente dal campo data_nascita (ISO "YYYY-MM-DD" o anche solo "YYYY").
// Mostrata tra parentesi accanto alla data di nascita nel banner panoramico.
function calcolaEta(iso) {
  if (!iso) return null;
  const m = String(iso).match(/(\d{4})(?:-(\d{2})-(\d{2}))?/);
  if (!m) return null;
  const anno = parseInt(m[1], 10);
  const mese = m[2] ? parseInt(m[2], 10) : 1;
  const giorno = m[3] ? parseInt(m[3], 10) : 1;
  const oggi = new Date();
  let eta = oggi.getFullYear() - anno;
  const meseOggi = oggi.getMonth() + 1;
  const giornoOggi = oggi.getDate();
  if (meseOggi < mese || (meseOggi === mese && giornoOggi < giorno)) eta--;
  return eta > 0 && eta < 120 ? eta : null;
}
const eta = calcolaEta(d.data_nascita);
// Etichetta neutra: dedurre il genere dal circuito e' sbagliato (una giocatrice
// classificata Challenger o ITF verrebbe descritta al maschile), quindi non lo
// deduciamo affatto.
const natoLabel = 'Nascita';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site}/giocatori/${d.slug_profilo}#person`,
  name: d.nome,
  nationality: d.nazionalita,
  birthDate: d.data_nascita,
  height: d.altezza,
  jobTitle: 'Tennista professionista',
  sport: 'Tennis',
  description: d.intro,
};
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${d.nome} - Profilo, carriera e statistiche`,
  description: d.descrizione,
  datePublished: d.generato_il,
  author: { '@type': 'Organization', name: 'Redazione AnalisiTennis' },
  publisher: {
    '@type': 'Organization',
    name: 'AnalisiTennis',
    logo: { '@type': 'ImageObject', url: `${site}/logo-schema.png` }
  },
  about: { '@id': `${site}/giocatori/${d.slug_profilo}#person` }
};

// Domande frequenti costruite SOLO da dati gia' nel profilo (nessun fatto
// nuovo inventato): rese visibili in pagina e come FAQPage schema. Aiuta i
// risultati arricchiti e la citabilita' da parte degli assistenti AI (GEO).
// Niente articoli di genere: il circuito non e' una fonte attendibile del sesso
// del giocatore e una frase sbagliata su questo e' un errore editoriale grave.
const annoNascita = d.data_nascita ? String(d.data_nascita).slice(0, 4) : null;
const faqItems = [];
if (ranking) {
  const dataAgg = rankingUpdated ? new Date(rankingUpdated).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' }) : null;
  faqItems.push({ q: `Che posizione occupa ${d.nome} nel ranking ${ranking.tour}?`, a: `${d.nome} è attualmente n. ${ranking.place} del ranking ${ranking.tour} con ${ranking.points} punti${dataAgg ? ` (aggiornato al ${dataAgg})` : ''}.` });
}
if (d.nazionalita) faqItems.push({ q: `Di dov'è ${d.nome}?`, a: `${d.nome} gioca per ${d.nazionalita}.` });
if (eta) faqItems.push({ q: `Quanti anni ha ${d.nome}?`, a: `${d.nome} ha ${eta} anni${annoNascita ? ` (classe ${annoNascita})` : ''}.` });
if (d.stile_gioco) faqItems.push({ q: `Che stile di gioco ha ${d.nome}?`, a: `Il gioco di ${d.nome} si caratterizza per ${d.stile_gioco}.` });
if (d.superficie_preferita) faqItems.push({ q: `Qual è la superficie preferita di ${d.nome}?`, a: `${d.nome} rende al meglio su ${d.superficie_preferita}.` });
if (d.titoli) faqItems.push({ q: `Quali titoli ha vinto ${d.nome}?`, a: `In carriera ${d.nome} ha conquistato ${d.titoli}.` });

// hreflang reciproco verso la versione inglese, solo se esiste (pilota EN).
const enAlternates = profilesEn[d.slug_profilo]
  ? [
      { lang: 'it', href: `${site}/giocatori/${d.slug_profilo}` },
      { lang: 'en', href: `${site}/en/players/${d.slug_profilo}` },
    ]
  : [];

const faqSchema = faqItems.length >= 2 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;
---
<Base
  titolo={`${d.nome}${d.nazionalita ? ` (${d.nazionalita})` : ''} - Profilo, carriera e analisi - AnalisiTennis`}
  descrizione={d.descrizione}
  tipo="article"
  alternates={enAlternates}
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <div class="contenitore" style="padding-top: 24px;">
    <Breadcrumbs items={[
      { nome: 'Home', url: '/' },
      { nome: 'Giocatori', url: '/giocatori' },
      { nome: d.nome }
    ]} />
  </div>

  <section class="homepage-hero" style="padding-top: 10px;">
    <div class="contenitore">
      <div class="articolo-eyebrow" style="justify-content: center; display: flex;">
        {d.categoria}{d.nazionalita ? ` · ${d.nazionalita}` : ''}{d.mano ? ` · ${d.mano}` : ''}
      </div>
      <h1>{d.nome}</h1>
      <p>{d.intro}</p>
    </div>
  </section>

  <div class="contenitore">
    <div class="layout-articolo">
      <article class="articolo">
        <div class="profilo-stats">
          {ranking && <div><strong>Ranking {ranking.tour}</strong>{' '}<a href={rankingUrl}>n. {ranking.place}</a>{' '}· {ranking.points} punti</div>}
          {d.data_nascita && <div><strong>{natoLabel}</strong>{' '}{d.data_nascita}{eta ? ` (${eta} anni)` : ''}</div>}
          {d.categoria && <div><strong>Circuito</strong>{' '}{d.categoria}</div>}
          {d.superficie_preferita && <div><strong>Superficie</strong>{' '}{d.superficie_preferita}</div>}
          {d.titoli && <div><strong>Titoli vinti</strong>{' '}{d.titoli}</div>}
          {d.stile_gioco && <div><strong>Stile di gioco</strong>{' '}{d.stile_gioco}</div>}
        </div>
        <div class="articolo-corpo">
          <Content />
        </div>
        {d.cover_credit && <p class="credit-foto">Foto: {d.cover_credit}</p>}

        {relatedArticles.length > 0 && (
          <section class="articoli-correlati" aria-label={`Analisi recenti su ${d.nome}`}>
            <h2>Nostre analisi recenti su {d.nome}</h2>
            <ul>
              {relatedArticles.map(a => {
                const dataIt = new Date(a.data.data).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
                const avv = playerSlug(a.data.giocatore1) === d.slug_profilo ? a.data.giocatore2 : a.data.giocatore1;
                return (
                  <li>
                    <a href={`/articoli/${a.slug}`}>
                      <span class="art-data">{dataIt}</span>
                      <span class="art-titolo">vs {avv} - {a.data.torneo}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )}

        {h2hLinks.length > 0 && (
          <section class="scontri-diretti-giocatore" aria-label={`Scontri diretti di ${d.nome}`}>
            <h2>Scontri diretti di {d.nome}</h2>
            <ul>
              {h2hLinks.map(x => (
                <li>
                  <a href={`/scontri-diretti/${x.pairSlug}`} class="sd-pair">
                    <span class="sd-vs">vs {x.oppName}</span>
                    <span class="sd-bil">{x.myWins}-{x.oppWins}</span>
                  </a>
                  {x.oppProfile && (
                    <a href={`/giocatori/${x.oppProfile}`} class="sd-prof" aria-label={`Profilo di ${x.oppName}`}>profilo</a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}

        {faqItems.length >= 2 && (
          <section class="profilo-faq" aria-label={`Domande frequenti su ${d.nome}`}>
            <h2>Domande frequenti su {d.nome}</h2>
            <dl>
              {faqItems.map(f => (
                <div class="faq-item">
                  <dt>{f.q}</dt>
                  <dd>{f.a}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}
      </article>
      <aside>
        <div class="side-sticky"><FormEmail /></div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .profilo-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 32px;
    padding: 16px 20px;
    background: var(--sfondo-card, #fff);
    border: 1px solid var(--linea, #e5e5e5);
    border-left: 3px solid var(--verde, #39d453);
    border-radius: 6px;
    margin-bottom: 28px;
    font-size: 0.92rem;
  }
  .profilo-stats strong {
    color: var(--testo-secondario, #6b7280);
    font-size: 0.72rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 700;
    display: block;
    margin-bottom: 2px;
  }
  .credit-foto {
    font-size: 0.75rem;
    color: var(--testo-secondario, #8a94a3);
    margin-top: 32px;
    padding-top: 12px;
    border-top: 1px solid var(--linea, #e5e5e5);
  }
  .profilo-faq {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--linea, #e5e5e5);
  }
  .profilo-faq h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0 0 16px;
    letter-spacing: -0.3px;
  }
  .profilo-faq dl { margin: 0; }
  .profilo-faq .faq-item { padding: 14px 0; border-bottom: 1px solid var(--linea, #eef1f4); }
  .profilo-faq dt { font-weight: 700; color: var(--testo, #1a1a1a); margin-bottom: 5px; }
  .profilo-faq dd { margin: 0; color: var(--testo-secondario, #4b5563); line-height: 1.55; }
  .articoli-correlati {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--linea, #e5e5e5);
  }
  .articoli-correlati h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0 0 16px;
    letter-spacing: -0.3px;
  }
  .articoli-correlati ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .articoli-correlati li { margin: 0; }
  .articoli-correlati a {
    display: flex;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--linea, #e5e5e5);
    text-decoration: none;
    color: var(--testo, #1a1a1a);
    align-items: baseline;
  }
  .articoli-correlati a:hover { color: var(--verde, #39d453); }
  .articoli-correlati .art-data {
    font-size: 0.82rem;
    color: var(--testo-secondario, #6b7280);
    flex-shrink: 0;
    min-width: 130px;
  }
  .articoli-correlati .art-titolo {
    font-weight: 500;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .scontri-diretti-giocatore {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--linea, #e5e5e5);
  }
  .scontri-diretti-giocatore h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0 0 16px;
    letter-spacing: -0.3px;
  }
  .scontri-diretti-giocatore ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 4px 20px;
  }
  .scontri-diretti-giocatore li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding: 11px 0;
    border-bottom: 1px solid var(--linea, #eef1f4);
  }
  .scontri-diretti-giocatore .sd-pair {
    display: flex;
    gap: 10px;
    align-items: baseline;
    text-decoration: none;
    color: var(--testo, #1a1a1a);
    min-width: 0;
    flex: 1;
  }
  .scontri-diretti-giocatore .sd-pair:hover { color: var(--verde, #39d453); }
  .scontri-diretti-giocatore .sd-vs {
    font-weight: 500;
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .scontri-diretti-giocatore .sd-bil {
    font-variant-numeric: tabular-nums;
    font-size: 0.82rem;
    color: var(--testo-secondario, #6b7280);
    flex-shrink: 0;
  }
  .scontri-diretti-giocatore .sd-prof {
    font-size: 0.78rem;
    color: var(--testo-secondario, #6b7280);
    text-decoration: none;
    border: 1px solid var(--linea, #e5e5e5);
    border-radius: 999px;
    padding: 2px 10px;
    flex-shrink: 0;
  }
  .scontri-diretti-giocatore .sd-prof:hover {
    color: var(--verde, #39d453);
    border-color: var(--verde, #39d453);
  }
</style>
