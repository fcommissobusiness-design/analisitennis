---
import Base from '../../layouts/Base.astro';
import FormEmail from '../../components/FormEmail.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { playerSlug } from '../../lib/hubs.js';

export async function getStaticPaths() {
  const profili = await getCollection('giocatori-profilo', ({ data }) => data.pubblicato !== false);
  const articoli = await getCollection('articoli', ({ data }) => data.pubblicato !== false);
  return profili.map(p => {
    const slug = p.data.slug_profilo;
    const relatedArticles = articoli
      .filter(a => playerSlug(a.data.giocatore1) === slug || playerSlug(a.data.giocatore2) === slug)
      .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
      .slice(0, 20);
    return { params: { slug }, props: { profilo: p, relatedArticles } };
  });
}

const { profilo, relatedArticles } = Astro.props;
const { Content } = await profilo.render();
const d = profilo.data;
const site = 'https://analisitennis.it';

// Eta' corrente dal campo data_nascita (ISO "YYYY-MM-DD" o anche solo "YYYY").
// Mostrata tra parentesi accanto alla data di nascita nel banner panoramico.
function calcolaEta(iso) {
  if (!iso) return null;
  const m = String(iso).match(/(\d{4})(?:-(\d{2})-(\d{2}))?/);
  if (!m) return null;
  const anno = parseInt(m[1], 10);
  const mese = m[2] ? parseInt(m[2], 10) : 1;
  const giorno = m[3] ? parseInt(m[3], 10) : 1;
  const oggi = new Date();
  let eta = oggi.getFullYear() - anno;
  const meseOggi = oggi.getMonth() + 1;
  const giornoOggi = oggi.getDate();
  if (meseOggi < mese || (meseOggi === mese && giornoOggi < giorno)) eta--;
  return eta > 0 && eta < 120 ? eta : null;
}
const eta = calcolaEta(d.data_nascita);
// "Nato" per gli uomini, "Nata" per le donne (deduciamo dal circuito WTA).
const natoLabel = d.categoria === 'WTA' ? 'Nata' : 'Nato';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site}/giocatori/${d.slug_profilo}#person`,
  name: d.nome,
  nationality: d.nazionalita,
  birthDate: d.data_nascita,
  height: d.altezza,
  jobTitle: 'Tennista professionista',
  sport: 'Tennis',
  description: d.intro,
};
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${d.nome} - Profilo, carriera e statistiche`,
  description: d.descrizione,
  datePublished: d.generato_il,
  author: { '@type': 'Organization', name: 'Redazione AnalisiTennis' },
  publisher: {
    '@type': 'Organization',
    name: 'AnalisiTennis',
    logo: { '@type': 'ImageObject', url: `${site}/logo-schema.png` }
  },
  about: { '@id': `${site}/giocatori/${d.slug_profilo}#person` }
};
---
<Base
  titolo={`${d.nome} - Profilo, carriera e stile di gioco - AnalisiTennis`}
  descrizione={d.descrizione}
  tipo="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div class="contenitore" style="padding-top: 24px;">
    <Breadcrumbs items={[
      { nome: 'Home', url: '/' },
      { nome: 'Giocatori', url: '/giocatori' },
      { nome: d.nome }
    ]} />
  </div>

  <section class="homepage-hero" style="padding-top: 10px;">
    <div class="contenitore">
      <div class="articolo-eyebrow" style="justify-content: center; display: flex;">
        {d.categoria || 'ATP'}{d.nazionalita ? ` · ${d.nazionalita}` : ''}{d.mano ? ` · ${d.mano}` : ''}
      </div>
      <h1>{d.nome}</h1>
      <p>{d.intro}</p>
    </div>
  </section>

  <div class="contenitore">
    <div class="layout-articolo">
      <article class="articolo">
        <div class="profilo-stats">
          {d.data_nascita && <div><strong>{natoLabel}</strong>{' '}{d.data_nascita}{eta ? ` (${eta} anni)` : ''}</div>}
          {d.categoria && <div><strong>Circuito</strong>{' '}{d.categoria}</div>}
          {d.superficie_preferita && <div><strong>Superficie</strong>{' '}{d.superficie_preferita}</div>}
          {d.titoli && <div><strong>Titoli vinti</strong>{' '}{d.titoli}</div>}
          {d.stile_gioco && <div><strong>Stile di gioco</strong>{' '}{d.stile_gioco}</div>}
        </div>
        <div class="articolo-corpo">
          <Content />
        </div>
        {d.cover_credit && <p class="credit-foto">Foto: {d.cover_credit}</p>}

        {relatedArticles.length > 0 && (
          <section class="articoli-correlati" aria-label={`Analisi recenti su ${d.nome}`}>
            <h2>Nostre analisi recenti su {d.nome}</h2>
            <ul>
              {relatedArticles.map(a => {
                const dataIt = new Date(a.data.data).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
                const avv = playerSlug(a.data.giocatore1) === d.slug_profilo ? a.data.giocatore2 : a.data.giocatore1;
                return (
                  <li>
                    <a href={`/articoli/${a.slug}`}>
                      <span class="art-data">{dataIt}</span>
                      <span class="art-titolo">vs {avv} - {a.data.torneo}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )}
      </article>
      <aside>
        <div class="side-sticky"><FormEmail /></div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .profilo-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 32px;
    padding: 16px 20px;
    background: var(--sfondo-card, #fff);
    border: 1px solid var(--linea, #e5e5e5);
    border-left: 3px solid var(--verde, #39d453);
    border-radius: 6px;
    margin-bottom: 28px;
    font-size: 0.92rem;
  }
  .profilo-stats strong {
    color: var(--testo-secondario, #6b7280);
    font-size: 0.72rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 700;
    display: block;
    margin-bottom: 2px;
  }
  .credit-foto {
    font-size: 0.75rem;
    color: var(--testo-secondario, #8a94a3);
    margin-top: 32px;
    padding-top: 12px;
    border-top: 1px solid var(--linea, #e5e5e5);
  }
  .articoli-correlati {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--linea, #e5e5e5);
  }
  .articoli-correlati h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0 0 16px;
    letter-spacing: -0.3px;
  }
  .articoli-correlati ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .articoli-correlati li { margin: 0; }
  .articoli-correlati a {
    display: flex;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--linea, #e5e5e5);
    text-decoration: none;
    color: var(--testo, #1a1a1a);
    align-items: baseline;
  }
  .articoli-correlati a:hover { color: var(--verde, #39d453); }
  .articoli-correlati .art-data {
    font-size: 0.82rem;
    color: var(--testo-secondario, #6b7280);
    flex-shrink: 0;
    min-width: 130px;
  }
  .articoli-correlati .art-titolo {
    font-weight: 500;
    font-size: 0.95rem;
    line-height: 1.4;
  }
</style>
