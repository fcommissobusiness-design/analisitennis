---
import Base from '../../layouts/Base.astro';
import FormEmail from '../../components/FormEmail.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import CoverArticolo from '../../components/CoverArticolo.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { playerSlug, tournamentSlug, tournamentDisplay, displayPlayerName } from '../../lib/hubs.js';

export async function getStaticPaths() {
  const articoli = await getCollection('articoli', ({ data }) => data.pubblicato !== false);
  // Pre-calcolo articoli correlati: stesso giocatore1/2 o stesso torneo-anno,
  // esclusi quello corrente. Ordinati per data desc, top 4.
  return articoli.map(a => {
    const g1 = a.data.giocatore1, g2 = a.data.giocatore2;
    const annoA = new Date(a.data.data).getFullYear();
    const tSlug = `${(a.data.torneo || '').toLowerCase().replace(/\s*-\s*qualification$/i, '').trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')}-${annoA}`;
    const correlati = articoli
      .filter(x => x.slug !== a.slug)
      .filter(x => {
        const xAnno = new Date(x.data.data).getFullYear();
        const xTSlug = `${(x.data.torneo || '').toLowerCase().replace(/\s*-\s*qualification$/i, '').trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')}-${xAnno}`;
        return (
          x.data.giocatore1 === g1 || x.data.giocatore2 === g1 ||
          x.data.giocatore1 === g2 || x.data.giocatore2 === g2 ||
          xTSlug === tSlug
        );
      })
      .sort((x, y) => y.data.data.valueOf() - x.data.data.valueOf())
      .slice(0, 4);
    return { params: { slug: a.slug }, props: { articolo: a, correlati } };
  });
}

const { articolo, correlati } = Astro.props;
const { Content, remarkPluginFrontmatter } = await articolo.render();
const d = articolo.data;

// Reading time: stima parole/200. Il body md e' nel compiled remark, come
// fallback contiamo i caratteri del verdetto + descrizione (~400 parole tipico).
const estimatedWords = 850; // media articoli AnalisiTennis
const readingMinutes = Math.max(3, Math.round(estimatedWords / 220));

// Set di slug con profili esistenti: cosi' il box "Approfondisci su"
// mostra solo link che risolvono davvero, niente 404.
const giocatoriProfili = await getCollection('giocatori-profilo', ({ data }) => data.pubblicato !== false);
const torneiProfili = await getCollection('tornei-profilo', ({ data }) => data.pubblicato !== false);
const playerSlugs = new Set(giocatoriProfili.map(p => p.data.slug_profilo));
const tournamentSlugs = new Set(torneiProfili.map(t => t.data.slug_profilo));

const site = 'https://analisitennis.it';
const anno = new Date(d.data).getFullYear();
const tSlug = tournamentSlug(d.torneo, anno);
const tDisplay = tournamentDisplay(d.torneo);
const g1Display = displayPlayerName(d.giocatore1);
const g2Display = displayPlayerName(d.giocatore2);
const g1Slug = playerSlug(d.giocatore1);
const g2Slug = playerSlug(d.giocatore2);
const hasG1 = playerSlugs.has(g1Slug);
const hasG2 = playerSlugs.has(g2Slug);
const hasTourn = tournamentSlugs.has(tSlug);
const anyHub = hasG1 || hasG2 || hasTourn;
const dataLocale = new Date(d.data).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${g1Display} contro ${g2Display} - ${tDisplay}`,
  startDate: d.data.toISOString(),
  sport: 'Tennis',
  location: { '@type': 'Place', name: tDisplay },
  competitor: [
    { '@type': 'Person', name: g1Display },
    { '@type': 'Person', name: g2Display }
  ],
  description: d.descrizione
};

const schemaArticle = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: d.titolo,
  description: d.descrizione,
  datePublished: (d.generato_il ? new Date(d.generato_il) : d.data).toISOString(),
  dateModified: (d.generato_il ? new Date(d.generato_il) : d.data).toISOString(),
  author: {
    '@type': 'Organization',
    name: 'Redazione AnalisiTennis',
    url: 'https://analisitennis.it/chi-siamo',
    logo: { '@type': 'ImageObject', url: 'https://analisitennis.it/logo-schema.png' }
  },
  publisher: {
    '@type': 'NewsMediaOrganization',
    '@id': 'https://analisitennis.it/#organization',
    name: 'AnalisiTennis',
    logo: { '@type': 'ImageObject', url: 'https://analisitennis.it/logo-schema.png', width: 400, height: 400 }
  },
  image: d.cover_image ? [`${site}${d.cover_image}`] : undefined,
  articleSection: `${d.categoria} - ${tDisplay}`,
  keywords: (d.tag || []).join(', '),
  wordCount: 850,
  inLanguage: 'it-IT',
  isAccessibleForFree: true,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${site}/articoli/${articolo.slug}` },
  about: [
    { '@type': 'Person', name: g1Display },
    { '@type': 'Person', name: g2Display },
    { '@type': 'SportsEvent', name: `${tDisplay} ${anno}` }
  ]
};

// FAQ Page: domande naturali che l'utente digita su Google
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `Chi vince tra ${g1Display} e ${g2Display}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: d.verdetto
      }
    },
    {
      '@type': 'Question',
      name: `Quando si gioca ${g1Display} contro ${g2Display}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Il match tra ${g1Display} e ${g2Display} del torneo ${tDisplay} ${anno} si gioca il ${dataLocale}. L'orario esatto varia a seconda del programma di giornata del torneo.`
      }
    },
    {
      '@type': 'Question',
      name: `Dove si gioca ${tDisplay} ${anno}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Il torneo ${tDisplay} ${anno} si gioca su superficie ${d.superficie} ed è categorizzato come ${d.categoria}.`
      }
    }
  ]
};
---
<Base
  titolo={`${d.titolo} - AnalisiTennis`}
  descrizione={d.descrizione}
  tipo="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(faq)} />

  <div class="contenitore" style="padding-top: 20px;">
    <Breadcrumbs items={[
      { nome: 'Home', url: '/' },
      { nome: `${tDisplay} ${anno}`, url: `/tornei/${tSlug}` },
      { nome: `${g1Display} - ${g2Display}` }
    ]} />
  </div>

  <div class="layout-articolo">
    <article class="articolo">
      {d.cover_image && d.giocatore1 !== 'Redazione' ? (
        <CoverArticolo
          cover_image={d.cover_image}
          titolo={d.titolo}
          sottotitolo={d.sottotitolo}
          torneo={d.torneo}
          categoria={d.categoria}
          superficie={d.superficie}
          credit={d.cover_credit}
        />
      ) : (
        <>
          <div class="articolo-eyebrow">{d.categoria} - {d.torneo} - {d.superficie}</div>
          <h1 class="articolo-titolo">{d.titolo}</h1>
          <p class="articolo-sottotitolo">{d.sottotitolo}</p>
        </>
      )}
      <div class="articolo-meta">
        <span>{d.autore}</span>
        <span>-</span>
        <span>
          {d.generato_il
            ? new Date(d.generato_il).toLocaleString('it-IT', {
                day: 'numeric', month: 'long', year: 'numeric',
                hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Rome'
              })
            : new Date(d.data).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })
          }
        </span>
        <span>-</span>
        <span aria-label="Tempo di lettura stimato">{readingMinutes} min di lettura</span>
      </div>

      <div class="articolo-corpo">
        <Content />
      </div>

      <div class="verdetto">
        <div class="label">Il nostro pronostico</div>
        <p>{d.verdetto}</p>
      </div>

      <ShareButtons url={Astro.url.href} titolo={d.titolo} />

      {d.giocatore1 !== 'Redazione' && anyHub && (
        <nav class="related-hubs" aria-label="Approfondimenti correlati">
          <div class="rh-label">Approfondisci su</div>
          <ul>
            {hasG1 && <li><a href={`/giocatori/${g1Slug}`}>{g1Display}</a></li>}
            {hasG2 && <li><a href={`/giocatori/${g2Slug}`}>{g2Display}</a></li>}
            {hasTourn && <li><a href={`/tornei/${tSlug}`}>{tDisplay} {anno}</a></li>}
          </ul>
        </nav>
      )}

      {correlati && correlati.length > 0 && (
        <section class="articoli-correlati-section" aria-label="Altre analisi che potrebbero interessarti">
          <h2>Altre analisi correlate</h2>
          <ul class="correlati-grid">
            {correlati.map(c => (
              <li>
                <a href={`/articoli/${c.slug}`}>
                  <div class="corr-eyebrow">{c.data.categoria} · {c.data.torneo}</div>
                  <div class="corr-titolo">{c.data.titolo}</div>
                  <div class="corr-data">{new Date(c.data.data).toLocaleDateString('it-IT', { day: 'numeric', month: 'long' })}</div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>

    <aside>
      <div class="side-sticky">
        <FormEmail />
      </div>
    </aside>
  </div>
</Base>

<style>
  .related-hubs {
    margin-top: 32px;
    padding: 18px 20px;
    background: var(--sfondo-card, #fff);
    border: 1px solid var(--linea, #e5e5e5);
    border-radius: 8px;
  }
  .related-hubs .rh-label {
    font-size: 0.72rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--testo-secondario, #6b7280);
    font-weight: 700;
    margin-bottom: 10px;
  }
  .related-hubs ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .related-hubs a {
    display: inline-block;
    padding: 6px 12px;
    background: var(--sfondo, #f6f6f3);
    border: 1px solid var(--linea, #e5e5e5);
    border-radius: 999px;
    color: var(--testo, #1a1a1a);
    text-decoration: none;
    font-size: 0.9rem;
    transition: border-color 0.15s, background 0.15s;
  }
  .related-hubs a:hover {
    border-color: var(--verde, #2a7f3e);
    color: var(--verde, #2a7f3e);
  }
  .articoli-correlati-section {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--linea, #e5e5e5);
  }
  .articoli-correlati-section h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 20px;
    letter-spacing: -0.3px;
  }
  .correlati-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
  }
  .correlati-grid li { margin: 0; }
  .correlati-grid a {
    display: block;
    padding: 16px 18px;
    background: var(--sfondo-card, #fff);
    border: 1px solid var(--linea, #e5e5e5);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    height: 100%;
    transition: border-color 0.15s, transform 0.15s;
  }
  .correlati-grid a:hover {
    border-color: var(--verde, #39d453);
    transform: translateY(-2px);
  }
  .corr-eyebrow {
    font-size: 0.7rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--verde, #2a7f3e);
    font-weight: 700;
    margin-bottom: 8px;
  }
  .corr-titolo {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.25;
    margin-bottom: 10px;
    color: var(--testo, #1a1a1a);
  }
  .corr-data {
    font-size: 0.78rem;
    color: var(--testo-secondario, #6b7280);
  }
</style>
