---
import Base from '../../layouts/Base.astro';
import FormEmail from '../../components/FormEmail.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import CoverArticolo from '../../components/CoverArticolo.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { playerSlug, tournamentSlug, tournamentDisplay, displayPlayerName, slugify } from '../../lib/hubs.js';
import h2hData from '../../data/h2h.json';

export async function getStaticPaths() {
  const articoli = await getCollection('articoli', ({ data }) => data.pubblicato !== false);
  // Pre-calcolo articoli correlati: stesso giocatore1/2 o stesso torneo-anno,
  // esclusi quello corrente. Ordinati per data desc, top 4.
  return articoli.map(a => {
    const g1 = a.data.giocatore1, g2 = a.data.giocatore2;
    const annoA = new Date(a.data.data).getFullYear();
    const tSlug = `${(a.data.torneo || '').toLowerCase().replace(/\s*-\s*qualification$/i, '').trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')}-${annoA}`;
    const correlati = articoli
      .filter(x => x.slug !== a.slug)
      .filter(x => {
        const xAnno = new Date(x.data.data).getFullYear();
        const xTSlug = `${(x.data.torneo || '').toLowerCase().replace(/\s*-\s*qualification$/i, '').trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')}-${xAnno}`;
        return (
          x.data.giocatore1 === g1 || x.data.giocatore2 === g1 ||
          x.data.giocatore1 === g2 || x.data.giocatore2 === g2 ||
          xTSlug === tSlug
        );
      })
      .sort((x, y) => y.data.data.valueOf() - x.data.data.valueOf())
      .slice(0, 4);
    return { params: { slug: a.slug }, props: { articolo: a, correlati } };
  });
}

const { articolo, correlati } = Astro.props;
const { Content, remarkPluginFrontmatter } = await articolo.render();
const d = articolo.data;

// Reading time: stima parole/200. Il body md e' nel compiled remark, come
// fallback contiamo i caratteri del verdetto + descrizione (~400 parole tipico).
const estimatedWords = 850; // media articoli AnalisiTennis
const readingMinutes = Math.max(3, Math.round(estimatedWords / 220));

// Set di slug con profili esistenti: cosi' il box "Approfondisci su"
// mostra solo link che risolvono davvero, niente 404.
const giocatoriProfili = await getCollection('giocatori-profilo', ({ data }) => data.pubblicato !== false);
const torneiProfili = await getCollection('tornei-profilo', ({ data }) => data.pubblicato !== false);
const playerSlugs = new Set(giocatoriProfili.map(p => p.data.slug_profilo));
const tournamentSlugs = new Set(torneiProfili.map(t => t.data.slug_profilo));

// Tag con una pagina reale (>=2 articoli): solo questi vengono linkati,
// cosi' i link tag nell'articolo non puntano a pagine 404.
const tuttiArticoli = await getCollection('articoli', ({ data }) => data.pubblicato !== false);
const tagCount = new Map();
for (const a of tuttiArticoli) for (const t of (a.data.tag || [])) {
  const s = slugify(t);
  if (s) tagCount.set(s, (tagCount.get(s) || 0) + 1);
}
const tagsArticolo = (d.tag || [])
  .map(t => ({ display: t, slug: slugify(t) }))
  .filter(t => t.slug && tagCount.get(t.slug) >= 2);

const site = 'https://analisitennis.it';
const anno = new Date(d.data).getFullYear();
const tSlug = tournamentSlug(d.torneo, anno);
const tDisplay = tournamentDisplay(d.torneo);
const g1Display = displayPlayerName(d.giocatore1);
const g2Display = displayPlayerName(d.giocatore2);
const g1Slug = playerSlug(d.giocatore1);
const g2Slug = playerSlug(d.giocatore2);
const hasG1 = playerSlugs.has(g1Slug);
const hasG2 = playerSlugs.has(g2Slug);
const hasTourn = tournamentSlugs.has(tSlug);

// Pagina scontri diretti (H2H) per questa coppia, se esiste. Lo slug e'
// ordinato alfabeticamente sui nomi completi (coerente con fetch_h2h.py).
const [sa, sb] = [slugify(g1Display), slugify(g2Display)].sort();
const h2hSlug = `${sa}-vs-${sb}`;
const hasH2H = Object.prototype.hasOwnProperty.call(h2hData, h2hSlug);
const anyHub = hasG1 || hasG2 || hasTourn;
const dataLocale = new Date(d.data).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${g1Display} contro ${g2Display} - ${tDisplay}`,
  startDate: d.data.toISOString(),
  endDate: d.data.toISOString(),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  sport: 'Tennis',
  location: { '@type': 'Place', name: tDisplay },
  image: d.cover_image ? [`${site}${d.cover_image}`] : undefined,
  competitor: [
    { '@type': 'Person', name: g1Display },
    { '@type': 'Person', name: g2Display }
  ],
  organizer: { '@type': 'Organization', name: d.categoria || 'ATP' },
  description: d.descrizione
};

const schemaArticle = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: d.titolo,
  description: d.descrizione,
  datePublished: (d.generato_il ? new Date(d.generato_il) : d.data).toISOString(),
  dateModified: (d.generato_il ? new Date(d.generato_il) : d.data).toISOString(),
  author: {
    '@type': 'Organization',
    name: 'Redazione AnalisiTennis',
    url: 'https://analisitennis.it/chi-siamo',
    logo: { '@type': 'ImageObject', url: 'https://analisitennis.it/logo-schema.png' }
  },
  publisher: {
    '@type': 'NewsMediaOrganization',
    '@id': 'https://analisitennis.it/#organization',
    name: 'AnalisiTennis',
    logo: { '@type': 'ImageObject', url: 'https://analisitennis.it/logo-schema.png', width: 400, height: 400 }
  },
  image: d.cover_image ? [`${site}${d.cover_image}`] : undefined,
  articleSection: `${d.categoria} - ${tDisplay}`,
  keywords: (d.tag || []).join(', '),
  wordCount: 850,
  inLanguage: 'it-IT',
  isAccessibleForFree: true,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${site}/articoli/${articolo.slug}` },
  about: [
    { '@type': 'Person', name: g1Display },
    { '@type': 'Person', name: g2Display },
    {
      '@type': 'SportsEvent',
      name: `${tDisplay} ${anno}`,
      startDate: d.data.toISOString(),
      sport: 'Tennis',
      location: { '@type': 'Place', name: tDisplay }
    }
  ]
};

// FAQ Page: domande naturali che l'utente digita su Google. Le risposte usano
// SOLO dati reali dell'articolo (la "chi vince" e' il nostro pronostico, gia'
// visibile nel riquadro verdetto). Lo stesso array alimenta sia lo schema sia
// la sezione VISIBILE in pagina: Google mostra i rich result FAQ solo se le
// domande compaiono anche nel contenuto, non solo nel JSON-LD.
const supLabel = ({ terra: 'terra rossa', cemento: 'cemento', erba: 'erba', indoor: 'cemento indoor' })[d.superficie] || d.superficie;
const faqItems = [
  { q: `Chi vince tra ${g1Display} e ${g2Display}?`, a: d.verdetto },
  { q: `Quando si gioca ${g1Display} contro ${g2Display}?`,
    a: `Il match tra ${g1Display} e ${g2Display} al torneo ${tDisplay} ${anno} si gioca il ${dataLocale}. L'orario esatto dipende dal programma di giornata del torneo.` },
  { q: `Su quale superficie si gioca ${tDisplay} ${anno}?`,
    a: `Il torneo ${tDisplay} ${anno} si gioca su ${supLabel} ed è un torneo ${d.categoria}.` },
];
if (hasH2H) {
  const b = h2hData[h2hSlug].bilancio || {};
  const p1n = b.p1 || 0, p2n = b.p2 || 0, tot = p1n + p2n;
  let txt;
  if (tot === 0) txt = `${g1Display} e ${g2Display} non si erano mai affrontati in un match ufficiale prima di questo.`;
  else if (p1n === p2n) txt = `Il bilancio dei precedenti ufficiali tra ${g1Display} e ${g2Display} è in parità: ${p1n}-${p2n} su ${tot} ${tot === 1 ? 'confronto' : 'confronti'}.`;
  else { const lead = p1n > p2n ? g1Display : g2Display, led = p1n > p2n ? g2Display : g1Display, hi = Math.max(p1n, p2n), lo = Math.min(p1n, p2n); txt = `Nei precedenti ufficiali ${lead} conduce ${hi}-${lo} su ${led}.`; }
  faqItems.push({ q: `Qual è il bilancio dei precedenti tra ${g1Display} e ${g2Display}?`, a: txt });
}
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  titolo={`${d.titolo} - AnalisiTennis`}
  descrizione={d.descrizione}
  immagine={d.cover_image}
  tipo="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(faq)} />

  <div class="contenitore" style="padding-top: 20px;">
    <Breadcrumbs items={[
      { nome: 'Home', url: '/' },
      { nome: `${tDisplay} ${anno}`, url: `/tornei/${tSlug}` },
      { nome: `${g1Display} - ${g2Display}` }
    ]} />
  </div>

  <div class="layout-articolo">
    <article class="articolo">
      {d.cover_image && d.giocatore1 !== 'Redazione' ? (
        <CoverArticolo
          cover_image={d.cover_image}
          titolo={d.titolo}
          sottotitolo={d.sottotitolo}
          torneo={d.torneo}
          categoria={d.categoria}
          superficie={d.superficie}
          credit={d.cover_credit}
        />
      ) : (
        <>
          <div class="articolo-eyebrow">{d.categoria} - {d.torneo} - {d.superficie}</div>
          <h1 class="articolo-titolo">{d.titolo}</h1>
          <p class="articolo-sottotitolo">{d.sottotitolo}</p>
        </>
      )}
      <div class="articolo-meta">
        <span>{d.autore}</span>
        <span>-</span>
        <span>
          {d.generato_il
            ? new Date(d.generato_il).toLocaleString('it-IT', {
                day: 'numeric', month: 'long', year: 'numeric',
                hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Rome'
              })
            : new Date(d.data).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })
          }
        </span>
        <span>-</span>
        <span aria-label="Tempo di lettura stimato">{readingMinutes} min di lettura</span>
      </div>

      {d.giocatore1 !== 'Redazione' && (
        <a href="#pronostico" class="goto-pronostico">
          <span class="gp-eyebrow">AnalisiTennis</span>
          <span class="gp-btn">
            VAI AL PRONOSTICO
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 4v14m0 0l-6-6m6 6l6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      )}

      <div class="articolo-corpo">
        <Content />
      </div>

      <div class="verdetto" id="pronostico">
        <div class="label">Il nostro pronostico</div>
        <p>{d.verdetto}</p>
      </div>

      <ShareButtons url={`${site}/articoli/${articolo.slug}`} titolo={d.titolo} />

      {tagsArticolo.length > 0 && (
        <nav class="tag-articolo" aria-label="Argomenti">
          {tagsArticolo.map(t => <a href={`/tag/${t.slug}`}>{t.display}</a>)}
        </nav>
      )}

      {hasH2H && (
        <a class="h2h-link" href={`/scontri-diretti/${h2hSlug}`}>
          <span class="h2h-link-eyebrow">Scontri diretti</span>
          <span class="h2h-link-text">Tutti i precedenti tra {g1Display} e {g2Display}</span>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14m0 0l-6-6m6 6l-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      )}

      {d.giocatore1 !== 'Redazione' && anyHub && (
        <nav class="related-hubs" aria-label="Approfondimenti correlati">
          <div class="rh-label">Approfondisci su</div>
          <ul>
            {hasG1 && <li><a href={`/giocatori/${g1Slug}`}>{g1Display}</a></li>}
            {hasG2 && <li><a href={`/giocatori/${g2Slug}`}>{g2Display}</a></li>}
            {hasTourn && <li><a href={`/tornei/${tSlug}`}>{tDisplay} {anno}</a></li>}
          </ul>
        </nav>
      )}

      {d.giocatore1 !== 'Redazione' && (
        <section class="articolo-faq" aria-label={`Domande frequenti su ${g1Display} - ${g2Display}`}>
          <h2>Domande frequenti</h2>
          <dl>
            {faqItems.map(f => (
              <div class="faq-item">
                <dt>{f.q}</dt>
                <dd>{f.a}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {correlati && correlati.length > 0 && (
        <section class="articoli-correlati-section" aria-label="Altre analisi che potrebbero interessarti">
          <h2>Altre analisi correlate</h2>
          <ul class="correlati-grid">
            {correlati.map(c => (
              <li>
                <a href={`/articoli/${c.slug}`}>
                  <div class="corr-eyebrow">{c.data.categoria} · {c.data.torneo}</div>
                  <div class="corr-titolo">{c.data.titolo}</div>
                  <div class="corr-data">{new Date(c.data.data).toLocaleDateString('it-IT', { day: 'numeric', month: 'long' })}</div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>

    <aside>
      <div class="side-sticky">
        <FormEmail />
      </div>
    </aside>
  </div>
</Base>

<style>
  /* Banner "VAI AL PRONOSTICO": brandizzato, porta subito all'esito in
     fondo. Scroll morbido + offset per non finire sotto l'header fisso. */
  .goto-pronostico {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 22px 0 8px;
    padding: 14px 16px 14px 20px;
    border-radius: 12px;
    text-decoration: none;
    color: #fff;
    background: linear-gradient(100deg, #0b0f14 0%, #15241a 100%);
    border: 1px solid rgba(57, 212, 83, 0.35);
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .goto-pronostico:hover {
    border-color: var(--verde, #39d453);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(57, 212, 83, 0.18);
  }
  .goto-pronostico .gp-eyebrow {
    font-size: 0.78rem; letter-spacing: 2px; text-transform: uppercase;
    font-weight: 800; color: var(--verde, #39d453); min-width: 0;
  }
  .goto-pronostico .gp-btn {
    flex-shrink: 0;
    display: inline-flex; align-items: center; gap: 7px;
    padding: 11px 16px;
    background: var(--verde, #39d453); color: #07120b;
    border-radius: 999px; font-weight: 800; font-size: 0.82rem;
    letter-spacing: 0.3px; white-space: nowrap;
  }
  .goto-pronostico .gp-btn svg { display: block; }
  #pronostico { scroll-margin-top: 90px; }
  @media (max-width: 560px) {
    .goto-pronostico { flex-direction: column; align-items: stretch; gap: 12px; padding: 16px; }
    .goto-pronostico .gp-btn { justify-content: center; padding: 13px 16px; }
  }

  .tag-articolo { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .tag-articolo a {
    font-size: 0.82rem; padding: 5px 11px; border-radius: 999px;
    background: var(--sfondo, #f6f6f3); border: 1px solid var(--linea, #e5e5e5);
    color: var(--testo-secondario, #555); text-decoration: none; transition: border-color 0.15s, color 0.15s;
  }
  .tag-articolo a:hover { border-color: var(--verde, #39d453); color: var(--verde, #2a7f3e); }

  .h2h-link { display: flex; align-items: center; gap: 12px; margin-top: 18px; padding: 14px 18px; border-radius: 12px; text-decoration: none; background: var(--sfondo-card, #fff); border: 1px solid var(--linea, #e5e5e5); transition: border-color 0.15s, transform 0.15s; }
  .h2h-link:hover { border-color: var(--verde, #39d453); transform: translateY(-1px); }
  .h2h-link-eyebrow { font-size: 0.66rem; letter-spacing: 1.8px; text-transform: uppercase; font-weight: 800; color: var(--verde, #2a7f3e); white-space: nowrap; }
  .h2h-link-text { flex: 1; font-weight: 600; color: var(--testo, #1a1a1a); min-width: 0; }
  .h2h-link svg { color: var(--verde, #2a7f3e); flex-shrink: 0; }
  @media (max-width: 520px) { .h2h-link { flex-wrap: wrap; } .h2h-link-text { flex-basis: 100%; order: 3; } }

  .related-hubs {
    margin-top: 32px;
    padding: 18px 20px;
    background: var(--sfondo-card, #fff);
    border: 1px solid var(--linea, #e5e5e5);
    border-radius: 8px;
  }
  .related-hubs .rh-label {
    font-size: 0.72rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--testo-secondario, #6b7280);
    font-weight: 700;
    margin-bottom: 10px;
  }
  .related-hubs ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .related-hubs a {
    display: inline-block;
    padding: 6px 12px;
    background: var(--sfondo, #f6f6f3);
    border: 1px solid var(--linea, #e5e5e5);
    border-radius: 999px;
    color: var(--testo, #1a1a1a);
    text-decoration: none;
    font-size: 0.9rem;
    transition: border-color 0.15s, background 0.15s;
  }
  .related-hubs a:hover {
    border-color: var(--verde, #2a7f3e);
    color: var(--verde, #2a7f3e);
  }
  .articoli-correlati-section {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--linea, #e5e5e5);
  }
  .articoli-correlati-section h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 20px;
    letter-spacing: -0.3px;
  }
  .correlati-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
  }
  .correlati-grid li { margin: 0; }
  .correlati-grid a {
    display: block;
    padding: 16px 18px;
    background: var(--sfondo-card, #fff);
    border: 1px solid var(--linea, #e5e5e5);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    height: 100%;
    transition: border-color 0.15s, transform 0.15s;
  }
  .correlati-grid a:hover {
    border-color: var(--verde, #39d453);
    transform: translateY(-2px);
  }
  .corr-eyebrow {
    font-size: 0.7rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--verde, #2a7f3e);
    font-weight: 700;
    margin-bottom: 8px;
  }
  .corr-titolo {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.25;
    margin-bottom: 10px;
    color: var(--testo, #1a1a1a);
  }
  .corr-data {
    font-size: 0.78rem;
    color: var(--testo-secondario, #6b7280);
  }
  .articolo-faq {
    margin-top: 44px;
    padding-top: 26px;
    border-top: 1px solid var(--linea, #e5e5e5);
  }
  .articolo-faq h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0 0 14px;
    letter-spacing: -0.3px;
  }
  .articolo-faq dl { margin: 0; }
  .articolo-faq .faq-item {
    padding: 14px 0;
    border-bottom: 1px solid var(--linea, #eef1f4);
  }
  .articolo-faq dt {
    font-weight: 700;
    color: var(--testo, #1a1a1a);
    margin-bottom: 5px;
  }
  .articolo-faq dd {
    margin: 0;
    color: var(--testo-secondario, #4b5563);
    line-height: 1.55;
  }
</style>
