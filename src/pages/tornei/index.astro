---
import Base from '../../layouts/Base.astro';
import FormEmail from '../../components/FormEmail.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { collectTournaments } from '../../lib/hubs.js';

const articoli = await getCollection('articoli', ({ data }) => data.pubblicato !== false);
const tornei = collectTournaments(articoli);

const site = 'https://analisitennis.it';
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: tornei.slice(0, 100).map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${site}/tornei/${t.slug}`,
    name: `${t.display} ${t.anno}`,
  })),
  numberOfItems: tornei.length,
};
---
<Base
  titolo="Tornei di tennis - Analisi tabelloni e pronostici - AnalisiTennis"
  descrizione="Hub dei tornei di tennis ATP, WTA, Slam e Challenger analizzati dalla Redazione AnalisiTennis: una pagina per ogni edizione con le nostre letture."
>
  <div class="contenitore" style="padding-top: 32px;">
    <Breadcrumbs items={[
      { nome: 'Home', url: '/' },
      { nome: 'Tornei' }
    ]} />
  </div>
  <section class="homepage-hero" style="padding-top: 10px;">
    <div class="contenitore">
      <h1>Tornei di <span class="verde">tennis</span></h1>
      <p>Una pagina per ciascuna edizione del torneo analizzata dalla Redazione, con tabellone, forma dei protagonisti e le nostre letture match per match.</p>
    </div>
  </section>
  <div class="contenitore">
    <div class="layout-home">
      <div>
        {tornei.length === 0 ? (
          <p style="color: var(--testo-secondario); padding: 48px 0;">Nessun torneo ancora indicizzato.</p>
        ) : (
          <ul class="hub-grid">
            {tornei.map(t => (
              <li class="hub-card">
                <a href={`/tornei/${t.slug}`}>
                  <div class="hub-nome">{t.display}</div>
                  <div class="hub-meta">{t.anno} - {t.articoli.length} {t.articoli.length === 1 ? 'analisi' : 'analisi'}</div>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      <aside><div class="side-sticky"><FormEmail /></div></aside>
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
</Base>

<style>
  .hub-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 60px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  .hub-card a {
    display: block;
    padding: 16px 18px;
    background: var(--sfondo-card, #fff);
    border: 1px solid var(--linea, #e5e5e5);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, transform 0.15s;
  }
  .hub-card a:hover {
    border-color: var(--verde, #2a7f3e);
    transform: translateY(-2px);
  }
  .hub-nome { font-weight: 600; font-size: 1rem; margin-bottom: 4px; }
  .hub-meta { font-size: 0.82rem; color: var(--testo-secondario, #6b7280); }
</style>
