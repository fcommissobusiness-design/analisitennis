---
import Base from '../../layouts/Base.astro';
import FormEmail from '../../components/FormEmail.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const profili = await getCollection('tornei-profilo', ({ data }) => data.pubblicato !== false);
const tornei = profili
  .map(p => p.data)
  .sort((a, b) => b.anno - a.anno || a.nome.localeCompare(b.nome, 'it'));

const site = 'https://analisitennis.it';
const norm = (s) => String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: tornei.slice(0, 100).map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${site}/tornei/${t.slug_profilo}`,
    name: `${t.nome} ${t.anno}`,
  })),
  numberOfItems: tornei.length,
};
---
<Base
  titolo="Tornei di tennis - Storia, curiosità e albo d'oro - AnalisiTennis"
  descrizione="Profili dei tornei di tennis ATP, WTA, Slam e Challenger: storia, curiosità, albo d'oro recente e caratteristiche del campo. Letture della Redazione AnalisiTennis."
>
  <div class="contenitore" style="padding-top: 32px;">
    <Breadcrumbs items={[
      { nome: 'Home', url: '/' },
      { nome: 'Tornei' }
    ]} />
  </div>
  <section class="homepage-hero" style="padding-top: 10px;">
    <div class="contenitore">
      <h1>Tornei di <span class="verde">tennis</span></h1>
      <p>Profili dei tornei analizzati dalla redazione: storia, curiosità, campo e albo d'oro recente. Ogni nuovo torneo trattato riceve il suo profilo.</p>
    </div>
  </section>
  <div class="contenitore">
    <div class="layout-home">
      <div>
        {tornei.length === 0 ? (
          <p style="color: var(--testo-secondario); padding: 48px 0;">Nessun profilo torneo pubblicato al momento. Li aggiungeremo mano a mano.</p>
        ) : (
          <>
          <div class="giocatori-search">
            <svg class="gs-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <input type="search" id="tornei-filtro" placeholder="Cerca un torneo (es. Parigi, Vienna, Cali...)" autocomplete="off" aria-label="Cerca un torneo per nome o città" />
          </div>
          <ul class="hub-grid" id="tornei-grid">
            {tornei.map(t => (
              <li class="hub-card" data-search={`${norm(t.nome)} ${norm(t.citta)} ${norm(t.paese)} ${t.anno}`}>
                <a href={`/tornei/${t.slug_profilo}`}>
                  {t.cover_image && (
                    <div class="hub-cover">
                      <picture>
                        <source srcset={t.cover_image.replace(/\.jpg$/, '-card.webp')} type="image/webp" />
                        <img src={t.cover_image} alt={`${t.nome} ${t.anno}`} loading="lazy" decoding="async" width="440" height="200" />
                      </picture>
                    </div>
                  )}
                  <div class="hub-body">
                    <div class="hub-nome">{t.nome} {t.anno}</div>
                    <div class="hub-meta">
                      {t.citta}{t.superficie ? ` · ${t.superficie}` : ''}
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
          <p class="italiani-nessuno" id="tornei-nessuno" hidden>Nessun torneo trovato. Prova con un'altra città o nome.</p>
          </>
        )}
      </div>
      <aside><div class="side-sticky"><FormEmail /></div></aside>
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
  <script>
    // Ricerca live dei tornei per nome o città.
    (function () {
      const grid = document.getElementById('tornei-grid');
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll('.hub-card'));
      const input = document.getElementById('tornei-filtro');
      const nessuno = document.getElementById('tornei-nessuno');
      function norm(s) { return (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim(); }
      function match(testo, q) {
        if (!q) return true;
        if (testo.indexOf(q) !== -1) return true;
        return testo.split(/\s+/).some(function (w) { return w.startsWith(q); });
      }
      function render() {
        const q = norm(input ? input.value : '');
        let visibili = 0;
        cards.forEach(function (card) {
          const ok = match(card.getAttribute('data-search') || '', q);
          card.hidden = !ok;
          if (ok) visibili++;
        });
        if (nessuno) nessuno.hidden = visibili !== 0;
      }
      if (input) input.addEventListener('input', render);
      render();
    })();
  </script>
</Base>

<style>
  .giocatori-search { position: relative; margin: 4px 0 20px; }
  .giocatori-search .gs-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--testo-secondario, #8a94a3); pointer-events: none; }
  .giocatori-search input {
    width: 100%; box-sizing: border-box; padding: 13px 16px 13px 42px; font-size: 1rem;
    color: var(--testo, #1a1a1a); background: var(--sfondo-card, #fff);
    border: 1px solid var(--linea, #e5e5e5); border-radius: 999px; outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .giocatori-search input:focus { border-color: var(--verde, #39d453); box-shadow: 0 0 0 3px rgba(57, 212, 83, 0.15); }
  .giocatori-search input::placeholder { color: var(--testo-secondario, #9aa3ad); }
  .italiani-nessuno { color: var(--testo-secondario, #6b7280); padding: 20px 0 48px; }
  .hub-grid {
    list-style: none; padding: 0; margin: 0 0 60px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  .hub-card a {
    display: block;
    background: var(--sfondo-card, #fff);
    border: 1px solid var(--linea, #e5e5e5);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: border-color 0.15s, transform 0.15s;
  }
  .hub-card a:hover {
    border-color: var(--verde, #39d453);
    transform: translateY(-2px);
  }
  .hub-cover {
    aspect-ratio: 22 / 10;
    background: #e9eef2;
    overflow: hidden;
  }
  .hub-cover picture { display: block; width: 100%; height: 100%; }
  .hub-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* alt-text trasparente durante il caricamento: il riquadro resta un
       placeholder pulito invece di sembrare un'immagine rotta. */
    color: transparent;
  }
  .hub-body { padding: 14px 16px; }
  .hub-nome { font-weight: 600; font-size: 1rem; margin-bottom: 4px; }
  .hub-meta { font-size: 0.82rem; color: var(--testo-secondario, #6b7280); }
</style>
