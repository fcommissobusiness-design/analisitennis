---
import Base from '../../layouts/Base.astro';
import FormEmail from '../../components/FormEmail.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { tournamentSlug } from '../../lib/hubs.js';

export async function getStaticPaths() {
  const profili = await getCollection('tornei-profilo', ({ data }) => data.pubblicato !== false);
  const articoli = await getCollection('articoli', ({ data }) => data.pubblicato !== false);
  return profili.map(p => {
    const slug = p.data.slug_profilo;
    const relatedArticles = articoli
      .filter(a => tournamentSlug(a.data.torneo, new Date(a.data.data).getFullYear()) === slug)
      .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
      .slice(0, 30);
    return { params: { slug }, props: { profilo: p, relatedArticles } };
  });
}

const { profilo, relatedArticles } = Astro.props;
const { Content } = await profilo.render();
const d = profilo.data;
const site = 'https://analisitennis.it';

// Periodo del torneo stimato dalle date delle nostre analisi (reale: i match
// che abbiamo coperto). Serve startDate/endDate, richiesti da Google per un
// SportsEvent valido (senza, Search Console segna errori critici e niente
// rich result Eventi).
const dateArticoli = relatedArticles.map(a => new Date(a.data.data)).sort((a, b) => a - b);
const startT = dateArticoli.length ? dateArticoli[0].toISOString() : new Date(`${d.anno}-01-01`).toISOString();
const endT = dateArticoli.length ? dateArticoli[dateArticoli.length - 1].toISOString() : startT;

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  '@id': `${site}/tornei/${d.slug_profilo}#event`,
  name: `${d.nome} ${d.anno}`,
  sport: 'Tennis',
  startDate: startT,
  endDate: endT,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: d.citta || d.nome,
    ...(d.paese ? { address: { '@type': 'PostalAddress', addressCountry: d.paese } } : {})
  },
  description: d.intro,
};

// FAQ torneo: da dati reali del profilo + conteggio delle nostre analisi.
const supLabelT = ({ terra: 'terra rossa', cemento: 'cemento', erba: 'erba', indoor: 'cemento indoor' })[d.superficie] || d.superficie;
const faqTorneo = [];
if (d.superficie) faqTorneo.push({ q: `Su quale superficie si gioca il torneo ${d.nome} ${d.anno}?`, a: `Il ${d.nome} ${d.anno} si gioca su ${supLabelT}${d.citta ? `, a ${d.citta}${d.paese ? ` (${d.paese})` : ''}` : ''}.` });
if (d.categoria) faqTorneo.push({ q: `Che categoria di torneo è il ${d.nome}?`, a: `Il ${d.nome} è un torneo di categoria ${d.categoria}${d.fondato ? `, disputato per la prima volta nel ${d.fondato}` : ''}.` });
if (relatedArticles.length > 0) faqTorneo.push({ q: `Quali match del ${d.nome} ${d.anno} ha analizzato AnalisiTennis?`, a: `La Redazione ha pubblicato ${relatedArticles.length} analisi di match del ${d.nome} ${d.anno}, con dati, scontri diretti e pronostici. Le trovi elencate in questa pagina.` });
const faqTorneoSchema = faqTorneo.length >= 2 ? {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqTorneo.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
} : null;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${d.nome} ${d.anno} - Storia, curiosita' e albo d'oro`,
  description: d.descrizione,
  datePublished: d.generato_il,
  author: { '@type': 'Organization', name: 'Redazione AnalisiTennis' },
  publisher: {
    '@type': 'Organization',
    name: 'AnalisiTennis',
    logo: { '@type': 'ImageObject', url: `${site}/logo-schema.png` }
  },
  about: { '@id': `${site}/tornei/${d.slug_profilo}#event` }
};
---
<Base
  titolo={`${d.nome} ${d.anno} - Storia e curiosita' del torneo - AnalisiTennis`}
  descrizione={d.descrizione}
  tipo="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqTorneoSchema && <script type="application/ld+json" set:html={JSON.stringify(faqTorneoSchema)} />}

  <div class="contenitore" style="padding-top: 24px;">
    <Breadcrumbs items={[
      { nome: 'Home', url: '/' },
      { nome: 'Tornei', url: '/tornei' },
      { nome: `${d.nome} ${d.anno}` }
    ]} />
  </div>

  <section class="homepage-hero" style="padding-top: 10px;">
    <div class="contenitore">
      <div class="articolo-eyebrow" style="justify-content: center; display: flex;">
        {d.categoria || 'ATP'}{d.superficie ? ` · ${d.superficie.toUpperCase()}` : ''}{d.citta ? ` · ${d.citta}` : ''}
      </div>
      <h1>{d.nome} {d.anno}</h1>
      <p>{d.intro}</p>
    </div>
  </section>

  <div class="contenitore">
    <div class="layout-articolo">
      <article class="articolo">
        <div class="profilo-stats">
          {d.citta && <div><strong>Luogo</strong>{' '}{d.citta}{d.paese ? `, ${d.paese}` : ''}</div>}
          {d.superficie && <div><strong>Superficie</strong>{' '}{d.superficie}</div>}
          {d.fondato && <div><strong>Fondato nel</strong>{' '}{d.fondato}</div>}
          {d.categoria && <div><strong>Categoria</strong>{' '}{d.categoria}</div>}
        </div>
        <div class="articolo-corpo">
          <Content />
        </div>
        {d.cover_credit && <p class="credit-foto">Foto: {d.cover_credit}</p>}

        {relatedArticles.length > 0 && (
          <section class="articoli-correlati" aria-label={`Analisi dei match del torneo ${d.nome} ${d.anno}`}>
            <h2>I nostri match analizzati di {d.nome} {d.anno}</h2>
            <ul>
              {relatedArticles.map(a => {
                const dataIt = new Date(a.data.data).toLocaleDateString('it-IT', { day: 'numeric', month: 'long' });
                return (
                  <li>
                    <a href={`/articoli/${a.slug}`}>
                      <span class="art-data">{dataIt}</span>
                      <span class="art-titolo">{a.data.giocatore1} vs {a.data.giocatore2}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )}

        {faqTorneo.length >= 2 && (
          <section class="torneo-faq" aria-label={`Domande frequenti sul ${d.nome} ${d.anno}`}>
            <h2>Domande frequenti sul {d.nome} {d.anno}</h2>
            <dl>
              {faqTorneo.map(f => (
                <div class="faq-item">
                  <dt>{f.q}</dt>
                  <dd>{f.a}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}
      </article>
      <aside>
        <div class="side-sticky"><FormEmail /></div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .profilo-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 32px;
    padding: 16px 20px;
    background: var(--sfondo-card, #fff);
    border: 1px solid var(--linea, #e5e5e5);
    border-left: 3px solid var(--verde, #39d453);
    border-radius: 6px;
    margin-bottom: 28px;
    font-size: 0.92rem;
  }
  .profilo-stats strong {
    color: var(--testo-secondario, #6b7280);
    font-size: 0.72rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 700;
    display: block;
    margin-bottom: 2px;
  }
  .credit-foto {
    font-size: 0.75rem;
    color: var(--testo-secondario, #8a94a3);
    margin-top: 32px;
    padding-top: 12px;
    border-top: 1px solid var(--linea, #e5e5e5);
  }
  .articoli-correlati {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--linea, #e5e5e5);
  }
  .articoli-correlati h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0 0 16px;
    letter-spacing: -0.3px;
  }
  .articoli-correlati ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .articoli-correlati li { margin: 0; }
  .articoli-correlati a {
    display: flex;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--linea, #e5e5e5);
    text-decoration: none;
    color: var(--testo, #1a1a1a);
    align-items: baseline;
  }
  .articoli-correlati a:hover { color: var(--verde, #39d453); }
  .articoli-correlati .art-data {
    font-size: 0.82rem;
    color: var(--testo-secondario, #6b7280);
    flex-shrink: 0;
    min-width: 110px;
  }
  .articoli-correlati .art-titolo {
    font-weight: 500;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .torneo-faq {
    margin-top: 44px;
    padding-top: 26px;
    border-top: 1px solid var(--linea, #e5e5e5);
  }
  .torneo-faq h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0 0 14px;
    letter-spacing: -0.3px;
  }
  .torneo-faq dl { margin: 0; }
  .torneo-faq .faq-item { padding: 14px 0; border-bottom: 1px solid var(--linea, #eef1f4); }
  .torneo-faq dt { font-weight: 700; color: var(--testo, #1a1a1a); margin-bottom: 5px; }
  .torneo-faq dd { margin: 0; color: var(--testo-secondario, #4b5563); line-height: 1.55; }
</style>
