---
import Base from '../../layouts/Base.astro';
import FormEmail from '../../components/FormEmail.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const profili = await getCollection('tornei-profilo', ({ data }) => data.pubblicato !== false);
  return profili.map(p => ({ params: { slug: p.data.slug_profilo }, props: { profilo: p } }));
}

const { profilo } = Astro.props;
const { Content } = await profilo.render();
const d = profilo.data;
const site = 'https://analisitennis.it';

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  '@id': `${site}/tornei/${d.slug_profilo}#event`,
  name: `${d.nome} ${d.anno}`,
  sport: 'Tennis',
  location: {
    '@type': 'Place',
    name: d.citta || d.nome,
    ...(d.paese ? { address: { '@type': 'PostalAddress', addressCountry: d.paese } } : {})
  },
  description: d.intro,
};
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${d.nome} ${d.anno} - Storia, curiosita' e albo d'oro`,
  description: d.descrizione,
  datePublished: d.generato_il,
  author: { '@type': 'Organization', name: 'Redazione AnalisiTennis' },
  publisher: {
    '@type': 'Organization',
    name: 'AnalisiTennis',
    logo: { '@type': 'ImageObject', url: `${site}/logo-schema.png` }
  },
  about: { '@id': `${site}/tornei/${d.slug_profilo}#event` }
};
---
<Base
  titolo={`${d.nome} ${d.anno} - Storia e curiosita' del torneo - AnalisiTennis`}
  descrizione={d.descrizione}
  tipo="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div class="contenitore" style="padding-top: 24px;">
    <Breadcrumbs items={[
      { nome: 'Home', url: '/' },
      { nome: 'Tornei', url: '/tornei' },
      { nome: `${d.nome} ${d.anno}` }
    ]} />
  </div>

  <section class="homepage-hero" style="padding-top: 10px;">
    <div class="contenitore">
      <div class="articolo-eyebrow" style="justify-content: center; display: flex;">
        {d.categoria || 'ATP'}{d.superficie ? ` · ${d.superficie.toUpperCase()}` : ''}{d.citta ? ` · ${d.citta}` : ''}
      </div>
      <h1>{d.nome} {d.anno}</h1>
      <p>{d.intro}</p>
    </div>
  </section>

  <div class="contenitore">
    <div class="layout-articolo">
      <article class="articolo">
        <div class="profilo-stats">
          {d.citta && <div><strong>Luogo</strong>{' '}{d.citta}{d.paese ? `, ${d.paese}` : ''}</div>}
          {d.superficie && <div><strong>Superficie</strong>{' '}{d.superficie}</div>}
          {d.fondato && <div><strong>Fondato nel</strong>{' '}{d.fondato}</div>}
          {d.categoria && <div><strong>Categoria</strong>{' '}{d.categoria}</div>}
        </div>
        <div class="articolo-corpo">
          <Content />
        </div>
        {d.cover_credit && <p class="credit-foto">Foto: {d.cover_credit}</p>}
      </article>
      <aside>
        <div class="side-sticky"><FormEmail /></div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .profilo-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 32px;
    padding: 16px 20px;
    background: var(--sfondo-card, #fff);
    border: 1px solid var(--linea, #e5e5e5);
    border-left: 3px solid var(--verde, #39d453);
    border-radius: 6px;
    margin-bottom: 28px;
    font-size: 0.92rem;
  }
  .profilo-stats strong {
    color: var(--testo-secondario, #6b7280);
    font-size: 0.72rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 700;
    display: block;
    margin-bottom: 2px;
  }
  .credit-foto {
    font-size: 0.75rem;
    color: var(--testo-secondario, #8a94a3);
    margin-top: 32px;
    padding-top: 12px;
    border-top: 1px solid var(--linea, #e5e5e5);
  }
</style>
