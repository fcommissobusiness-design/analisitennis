---
// Template unico per /tornei/{slug}: gestisce sia il profilo torneo-anno
// (es. /tornei/paris-2026) sia il hub torneo pluriennale (es. /tornei/wimbledon).
// Gli slug non collidono: lo yearly include l'anno (-2026), il hub no.
// Rendering branchato per d.kind: 'hub' o 'anno'.
import Base from '../../layouts/Base.astro';
import FormEmail from '../../components/FormEmail.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ConsigliatiTennis from '../../components/ConsigliatiTennis.astro';
import SupportaRedazione from '../../components/SupportaRedazione.astro';
import { getCollection } from 'astro:content';
import { tournamentSlug } from '../../lib/hubs.js';

export async function getStaticPaths() {
  const profili = await getCollection('tornei-profilo', ({ data }) => data.pubblicato !== false);
  const hubs = await getCollection('tornei-hub', ({ data }) => data.pubblicato !== false);
  const articoli = await getCollection('articoli', ({ data }) => data.pubblicato !== false);

  // Paths per i profili anno singolo: logica invariata dal template precedente.
  const annoPaths = profili.map(p => {
    const slug = p.data.slug_profilo;
    const related = articoli
      .filter(a => tournamentSlug(a.data.torneo, new Date(a.data.data).getFullYear()) === slug)
      .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf());
    const relatedArticles = related.slice(0, 30);
    return { params: { slug }, props: { kind: 'anno', profilo: p, relatedArticles, profiliAnnoHub: [] } };
  });

  // Paths per gli hub pluriennali. Per ogni hub trovo i profili anno
  // associati dello stesso torneo: match su slug_profilo = `${hub}-${anno}`
  // oppure prefisso uguale al hub-slug. Il link ai profili anno e' il
  // ponte editoriale fra pilastro (hub) e singole edizioni.
  const hubPaths = hubs.map(h => {
    const hubSlug = h.data.slug_profilo;
    const profiliAnnoHub = profili
      .filter(p => {
        const ps = p.data.slug_profilo;
        return ps.startsWith(hubSlug + '-') && /\d{4}$/.test(ps);
      })
      .map(p => p.data)
      .sort((a, b) => b.anno - a.anno);
    return { params: { slug: hubSlug }, props: { kind: 'hub', profilo: h, profiliAnnoHub, relatedArticles: [] } };
  });

  return [...annoPaths, ...hubPaths];
}

const { kind, profilo, relatedArticles, profiliAnnoHub } = Astro.props;
const { Content } = await profilo.render();
const d = profilo.data;
const site = 'https://analisitennis.it';

// === BRANCH ANNO SINGOLO (torneo-profilo, es. paris-2026) ======================
// Logica invariata rispetto al template precedente.
const supLabelT = ({ terra: 'terra rossa', cemento: 'cemento', erba: 'erba', indoor: 'cemento indoor' })[d.superficie] || d.superficie;
let eventSchema = null;
let articleSchema = null;
let faqTorneoSchema = null;
let faqTorneo = [];

if (kind === 'anno') {
  const dateArticoli = relatedArticles.map(a => new Date(a.data.data)).sort((a, b) => a - b);
  const startT = dateArticoli.length ? dateArticoli[0].toISOString() : new Date(`${d.anno}-01-01`).toISOString();
  const endT = dateArticoli.length ? dateArticoli[dateArticoli.length - 1].toISOString() : startT;

  eventSchema = {
    '@context': 'https://schema.org',
    '@type': 'SportsEvent',
    '@id': `${site}/tornei/${d.slug_profilo}#event`,
    name: `${d.nome} ${d.anno}`,
    sport: 'Tennis',
    startDate: startT,
    endDate: endT,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: d.citta || d.nome,
      ...(d.paese ? { address: { '@type': 'PostalAddress', addressCountry: d.paese } } : {})
    },
    description: d.intro,
  };

  if (d.superficie) faqTorneo.push({ q: `Su quale superficie si gioca il torneo ${d.nome} ${d.anno}?`, a: `Il ${d.nome} ${d.anno} si gioca su ${supLabelT}${d.citta ? `, a ${d.citta}${d.paese ? ` (${d.paese})` : ''}` : ''}.` });
  if (d.categoria) faqTorneo.push({ q: `Che categoria di torneo è il ${d.nome}?`, a: `Il ${d.nome} è un torneo di categoria ${d.categoria}${d.fondato ? `, disputato per la prima volta nel ${d.fondato}` : ''}.` });
  if (relatedArticles.length > 0) faqTorneo.push({ q: `Quali match del ${d.nome} ${d.anno} ha analizzato AnalisiTennis?`, a: `La Redazione ha pubblicato ${relatedArticles.length} analisi di match del ${d.nome} ${d.anno}, con dati, scontri diretti e pronostici. Le trovi elencate in questa pagina.` });
  faqTorneoSchema = faqTorneo.length >= 2 ? {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqTorneo.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  } : null;

  articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: `${d.nome} ${d.anno} - Storia, curiosità e albo d'oro`,
    description: d.descrizione,
    datePublished: d.generato_il,
    author: { '@type': 'Organization', name: 'Redazione AnalisiTennis' },
    publisher: {
      '@type': 'Organization',
      name: 'AnalisiTennis',
      logo: { '@type': 'ImageObject', url: `${site}/logo-schema.png` }
    },
    about: { '@id': `${site}/tornei/${d.slug_profilo}#event` }
  };
}

// === BRANCH HUB PLURIENNALE (torneo-hub, es. wimbledon) =======================
// Schema editoriale senza SportsEvent (non e' un evento datato).
// FAQPage dalle Q&A verificate nel frontmatter.
let hubArticleSchema = null;
let hubFaqSchema = null;

if (kind === 'hub') {
  hubArticleSchema = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: `${d.nome} - Storia, albo d'oro e record del torneo`,
    description: d.descrizione,
    datePublished: d.generato_il,
    author: { '@type': 'Organization', name: 'Redazione AnalisiTennis' },
    publisher: {
      '@type': 'Organization',
      name: 'AnalisiTennis',
      logo: { '@type': 'ImageObject', url: `${site}/logo-schema.png` }
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `${site}/tornei/${d.slug_profilo}`
    }
  };

  if (Array.isArray(d.faq) && d.faq.length >= 2) {
    hubFaqSchema = {
      '@context': 'https://schema.org', '@type': 'FAQPage',
      mainEntity: d.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    };
  }
  // BreadcrumbList e' emesso dal componente Breadcrumbs, qui non duplicarlo.
}

const supLabel = ({ terra: 'terra rossa', cemento: 'cemento', erba: 'erba', indoor: 'cemento indoor' })[d.superficie] || d.superficie;
---
<Base
  titolo={kind === 'hub'
    ? `${d.nome} - Storia, albo d'oro e record - AnalisiTennis`
    : `${d.nome} ${d.anno} - Storia e curiosità del torneo - AnalisiTennis`}
  descrizione={d.descrizione}
  tipo="article"
>
  {kind === 'anno' && (
    <>
      <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
      {faqTorneoSchema && <script type="application/ld+json" set:html={JSON.stringify(faqTorneoSchema)} />}
    </>
  )}
  {kind === 'hub' && (
    <>
      <script type="application/ld+json" set:html={JSON.stringify(hubArticleSchema)} />
      {hubFaqSchema && <script type="application/ld+json" set:html={JSON.stringify(hubFaqSchema)} />}
    </>
  )}

  <div class="contenitore" style="padding-top: 24px;">
    <Breadcrumbs items={[
      { nome: 'Home', url: '/' },
      { nome: 'Tornei', url: '/tornei' },
      { nome: kind === 'hub' ? d.nome : `${d.nome} ${d.anno}` }
    ]} />
  </div>

  <section class="homepage-hero" style="padding-top: 10px;">
    <div class="contenitore">
      <div class="articolo-eyebrow" style="justify-content: center; display: flex;">
        {d.categoria || 'ATP'}{d.superficie ? ` · ${d.superficie.toUpperCase()}` : ''}{d.citta ? ` · ${d.citta}` : ''}
      </div>
      <h1>{kind === 'hub' ? d.nome : `${d.nome} ${d.anno}`}</h1>
      <p>{d.intro}</p>
    </div>
  </section>

  <div class="contenitore">
    <div class="layout-articolo">
      <article class="articolo">
        <div class="profilo-stats">
          {d.citta && <div><strong>Luogo</strong>{' '}{d.citta}{d.paese ? `, ${d.paese}` : ''}</div>}
          {d.superficie && <div><strong>Superficie</strong>{' '}{d.superficie}</div>}
          {d.fondato && <div><strong>Fondato nel</strong>{' '}{d.fondato}</div>}
          {d.categoria && <div><strong>Categoria</strong>{' '}{d.categoria}</div>}
          {kind === 'hub' && d.sede && <div><strong>Sede</strong>{' '}{d.sede}</div>}
          {kind === 'hub' && d.record_titoli_m && <div><strong>Record titoli (M)</strong>{' '}{d.record_titoli_m}</div>}
          {kind === 'hub' && d.record_titoli_f && <div><strong>Record titoli (F)</strong>{' '}{d.record_titoli_f}</div>}
        </div>
        <div class="articolo-corpo">
          <Content />
        </div>
        {d.cover_credit && <p class="credit-foto">Foto: {d.cover_credit}</p>}

        {kind === 'hub' && profiliAnnoHub.length > 0 && (
          <section class="articoli-correlati" aria-label={`Edizioni analizzate di ${d.nome}`}>
            <h2>Edizioni analizzate di {d.nome}</h2>
            <p class="hub-edizioni-intro">Ecco le edizioni del {d.nome} per cui abbiamo pubblicato un profilo torneo dedicato, con storia della singola stagione e match analizzati.</p>
            <ul>
              {profiliAnnoHub.map(p => (
                <li>
                  <a href={`/tornei/${p.slug_profilo}`}>
                    <span class="art-data">{p.anno}</span>
                    <span class="art-titolo">{p.nome} {p.anno}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {kind === 'anno' && relatedArticles.length > 0 && (
          <section class="articoli-correlati" aria-label={`Analisi dei match del torneo ${d.nome} ${d.anno}`}>
            <h2>I nostri match analizzati di {d.nome} {d.anno}</h2>
            <ul>
              {relatedArticles.map(a => {
                const dataIt = new Date(a.data.data).toLocaleDateString('it-IT', { day: 'numeric', month: 'long' });
                return (
                  <li>
                    <a href={`/articoli/${a.slug}`}>
                      <span class="art-data">{dataIt}</span>
                      <span class="art-titolo">{a.data.giocatore1} vs {a.data.giocatore2}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )}

        {kind === 'anno' && faqTorneo.length >= 2 && (
          <section class="torneo-faq" aria-label={`Domande frequenti sul ${d.nome} ${d.anno}`}>
            <h2>Domande frequenti sul {d.nome} {d.anno}</h2>
            <dl>
              {faqTorneo.map(f => (
                <div class="faq-item">
                  <dt>{f.q}</dt>
                  <dd>{f.a}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        {kind === 'hub' && Array.isArray(d.faq) && d.faq.length >= 2 && (
          <section class="torneo-faq" aria-label={`Domande frequenti sul ${d.nome}`}>
            <h2>Domande frequenti sul {d.nome}</h2>
            <dl>
              {d.faq.map(f => (
                <div class="faq-item">
                  <dt>{f.q}</dt>
                  <dd>{f.a}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        <ConsigliatiTennis contesto="torneo" superficie={d.superficie || ''} seed={Astro.params.slug} />

        <SupportaRedazione stile="breve" />
      </article>
      <aside>
        <div class="side-sticky"><FormEmail /></div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .profilo-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 32px;
    padding: 16px 20px;
    background: var(--sfondo-card, #fff);
    border: 1px solid var(--linea, #e5e5e5);
    border-left: 3px solid var(--verde, #39d453);
    border-radius: 6px;
    margin-bottom: 28px;
    font-size: 0.92rem;
  }
  .profilo-stats strong {
    color: var(--testo-secondario, #6b7280);
    font-size: 0.72rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 700;
    display: block;
    margin-bottom: 2px;
  }
  .credit-foto {
    font-size: 0.75rem;
    color: var(--testo-secondario, #8a94a3);
    margin-top: 32px;
    padding-top: 12px;
    border-top: 1px solid var(--linea, #e5e5e5);
  }
  .articoli-correlati {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--linea, #e5e5e5);
  }
  .articoli-correlati h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0 0 16px;
    letter-spacing: -0.3px;
  }
  .articoli-correlati ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .articoli-correlati li { margin: 0; }
  .articoli-correlati a {
    display: flex;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--linea, #e5e5e5);
    text-decoration: none;
    color: var(--testo, #1a1a1a);
    align-items: baseline;
  }
  .articoli-correlati a:hover { color: var(--verde, #39d453); }
  .articoli-correlati .art-data {
    font-size: 0.82rem;
    color: var(--testo-secondario, #6b7280);
    flex-shrink: 0;
    min-width: 110px;
  }
  .articoli-correlati .art-titolo {
    font-weight: 500;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .hub-edizioni-intro {
    color: var(--testo-secondario, #4b5563);
    margin: 0 0 12px;
    font-size: 0.95rem;
  }
  .torneo-faq {
    margin-top: 44px;
    padding-top: 26px;
    border-top: 1px solid var(--linea, #e5e5e5);
  }
  .torneo-faq h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0 0 14px;
    letter-spacing: -0.3px;
  }
  .torneo-faq dl { margin: 0; }
  .torneo-faq .faq-item { padding: 14px 0; border-bottom: 1px solid var(--linea, #eef1f4); }
  .torneo-faq dt { font-weight: 700; color: var(--testo, #1a1a1a); margin-bottom: 5px; }
  .torneo-faq dd { margin: 0; color: var(--testo-secondario, #4b5563); line-height: 1.55; }
</style>
