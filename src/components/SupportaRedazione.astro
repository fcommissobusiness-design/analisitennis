---
// Box "Supporta la redazione" via Revolut.
//
// Tre stili:
//   - inline : box grande, SOLO sotto le analisi partita (pronostici)
//   - breve  : riga sobria "Testata Giornalistica Indipendente: Supporta la
//              nostra Redazione ->" per profili, tornei, guide
//   - footer : stessa dicitura breve, come banda poco prima del footer

interface Props {
  stile?: 'inline' | 'breve' | 'footer';
}
const { stile = 'breve' } = Astro.props as Props;

const URL_SUPPORT_DEFAULT = 'https://revolut.me/filco0/pocket/9H3U5kEDaC';
const URL_SUPPORT = import.meta.env.PUBLIC_SUPPORT_URL || URL_SUPPORT_DEFAULT;
const show = Boolean(URL_SUPPORT);
---

{show && stile === 'inline' && (
  <aside class="sup-inline" aria-label="Supporta la redazione di AnalisiTennis">
    <p>
      <strong>Ti è servita questa analisi?</strong> AnalisiTennis è una testata indipendente.
      Se vuoi sostenere il nostro lavoro, puoi offrirci un caffè virtuale.
    </p>
    <a class="sup-btn" href={URL_SUPPORT} rel="noopener" target="_blank">
      Supporta la redazione
    </a>
  </aside>
)}

{show && stile === 'breve' && (
  <p class="sup-breve" aria-label="Supporta la redazione">
    <span>Testata Giornalistica Indipendente: </span>
    <a href={URL_SUPPORT} rel="noopener" target="_blank">Supporta la nostra Redazione &rarr;</a>
  </p>
)}

{show && stile === 'footer' && (
  <div class="sup-footer" aria-label="Supporta la redazione">
    <span>Testata Giornalistica Indipendente: </span>
    <a href={URL_SUPPORT} rel="noopener" target="_blank">Supporta la nostra Redazione &rarr;</a>
  </div>
)}

<style>
  .sup-inline {
    border-left: 3px solid #39d453;
    background: #f6fbf5;
    padding: 14px 18px;
    margin: 28px 0;
    border-radius: 0 10px 10px 0;
  }
  .sup-inline p { margin: 0 0 10px; font-size: 0.98rem; color: #1a1a1a; line-height: 1.5; }
  .sup-btn {
    display: inline-block;
    background: #0b0f14;
    color: #ffffff !important;
    padding: 9px 18px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    font-size: 0.95rem;
    transition: transform 0.08s ease, background 0.12s ease;
  }
  .sup-btn:hover { background: #39d453; color: #0b0f14 !important; transform: translateY(-1px); }

  .sup-breve {
    margin: 26px 0 0;
    padding-top: 14px;
    border-top: 1px solid #ececec;
    font-size: 0.95rem;
    color: #444;
  }
  .sup-breve a { color: #2a6b1d; font-weight: 600; text-decoration: none; }
  .sup-breve a:hover { text-decoration: underline; }

  .sup-footer {
    text-align: center;
    font-size: 0.92rem;
    padding: 14px 20px;
    background: #f0faee;
    color: #1a1a1a;
    border-top: 1px solid #d8ebd3;
  }
  .sup-footer a { color: #2a6b1d; font-weight: 600; text-decoration: none; }
  .sup-footer a:hover { text-decoration: underline; }

  @media (max-width: 640px) {
    .sup-inline { padding: 14px 16px; }
  }
</style>
