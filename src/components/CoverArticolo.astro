---
const { giocatore1, giocatore2, torneo, superficie, categoria } = Astro.props;

// Palette superficie
const superficePalette = {
  'terra': { bg1: '#c6694a', bg2: '#8a4028', net: '#f4f4f0', label: 'TERRA ROSSA' },
  'cemento': { bg1: '#2d5f8a', bg2: '#193c5a', net: '#f4f4f0', label: 'CEMENTO' },
  'erba': { bg1: '#3f7e38', bg2: '#1f4a1b', net: '#f4f4f0', label: 'ERBA' },
  'indoor': { bg1: '#4a3f6b', bg2: '#2a2340', net: '#f4f4f0', label: 'INDOOR' },
};
const p = superficePalette[superficie] || superficePalette['cemento'];

// Normalizza nomi corti
function shortName(n) {
  if (!n) return '';
  const parts = n.trim().split(/\s+/);
  if (parts.length < 2) return n;
  const last = parts[parts.length - 1];
  const first = parts[0];
  if (first.endsWith('.')) return `${first.charAt(0)}. ${last}`.toUpperCase();
  return `${first.charAt(0)}. ${last}`.toUpperCase();
}

const p1 = shortName(giocatore1);
const p2 = shortName(giocatore2);
---
<div class="cover-articolo" aria-hidden="true">
  <svg viewBox="0 0 1200 500" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="grad-bg" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color={p.bg1}/>
        <stop offset="100%" stop-color={p.bg2}/>
      </linearGradient>
      <radialGradient id="grad-ball" cx="30%" cy="30%" r="70%">
        <stop offset="0%" stop-color="#f4ff4a"/>
        <stop offset="80%" stop-color="#c9d422"/>
        <stop offset="100%" stop-color="#9fa818"/>
      </radialGradient>
      <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur in="SourceAlpha" stdDeviation="8"/>
        <feOffset dx="0" dy="6" result="offsetblur"/>
        <feFlood flood-color="#000" flood-opacity="0.35"/>
        <feComposite in2="offsetblur" operator="in"/>
        <feMerge>
          <feMergeNode/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>

    <!-- Sfondo -->
    <rect width="1200" height="500" fill="url(#grad-bg)"/>

    <!-- Linee di campo tennis (prospettiva) -->
    <g opacity="0.25" stroke="#fff" stroke-width="2.5" fill="none">
      <!-- Rete centrale -->
      <line x1="0" y1="250" x2="1200" y2="250" stroke-width="4" opacity="0.8"/>
      <!-- Linee laterali in prospettiva -->
      <path d="M 100 500 L 450 100"/>
      <path d="M 1100 500 L 750 100"/>
      <!-- Linea di fondo -->
      <path d="M 60 480 L 1140 480" stroke-width="3"/>
      <path d="M 460 90 L 740 90" stroke-width="3"/>
      <!-- Linee del servizio -->
      <path d="M 275 300 L 925 300"/>
      <path d="M 600 180 L 600 320"/>
    </g>

    <!-- Pallina da tennis (angolo in alto a destra) -->
    <g filter="url(#shadow)">
      <circle cx="1070" cy="90" r="46" fill="url(#grad-ball)"/>
      <path d="M 1030 65 Q 1070 90 1030 115" stroke="#f4f4f0" stroke-width="3" fill="none" opacity="0.9"/>
      <path d="M 1110 65 Q 1070 90 1110 115" stroke="#f4f4f0" stroke-width="3" fill="none" opacity="0.9"/>
    </g>

    <!-- Eyebrow categoria + torneo + superficie -->
    <text x="60" y="90" font-family="-apple-system, 'Segoe UI', sans-serif" font-size="22" font-weight="700" fill="#39d453" letter-spacing="3">
      {categoria.toUpperCase()} · {p.label}
    </text>
    <text x="60" y="125" font-family="-apple-system, 'Segoe UI', sans-serif" font-size="26" font-weight="600" fill="#fff" opacity="0.9">
      {torneo}
    </text>

    <!-- Giocatori -->
    <g>
      <!-- Giocatore 1 -->
      <text x="60" y="275" font-family="'Playfair Display', Georgia, serif" font-size="76" font-weight="900" fill="#ffffff" filter="url(#shadow)">
        {p1}
      </text>
      <!-- VS -->
      <text x="60" y="340" font-family="-apple-system, 'Segoe UI', sans-serif" font-size="48" font-weight="800" fill="#39d453" letter-spacing="4">
        VS
      </text>
      <!-- Giocatore 2 -->
      <text x="60" y="420" font-family="'Playfair Display', Georgia, serif" font-size="76" font-weight="900" fill="#ffffff" filter="url(#shadow)">
        {p2}
      </text>
    </g>

    <!-- Badge AnalisiTennis angolo in basso dx -->
    <g transform="translate(960, 420)">
      <rect x="0" y="0" width="200" height="46" rx="23" fill="#0a0e14" opacity="0.75"/>
      <text x="100" y="30" text-anchor="middle" font-family="-apple-system, 'Segoe UI', sans-serif" font-size="17" font-weight="700" fill="#39d453" letter-spacing="2">
        ANALISITENNIS
      </text>
    </g>
  </svg>
</div>
