---
// Cover articolo: foto reale + titolo in sovraimpressione.
// Priorita' assoluta: il titolo NON deve mai essere tagliato.
// Il contenitore cresce in altezza con il titolo; l'immagine resta object-fit cover.
const { cover_image, titolo, torneo, categoria, superficie, sottotitolo, credit } = Astro.props;

const superficeLabel = {
  terra: 'TERRA ROSSA',
  cemento: 'CEMENTO',
  erba: 'ERBA',
  indoor: 'INDOOR'
}[superficie] || 'CEMENTO';
---
<figure class="cover-articolo">
  <div class="cover-frame">
    <img src={cover_image} alt={`${titolo} - ${torneo}`} loading="eager" fetchpriority="high" />
    <div class="cover-overlay"></div>
    <div class="cover-top">
      <span class="cat">{categoria?.toUpperCase()} · {superficeLabel} · {torneo?.toUpperCase()}</span>
    </div>
    <div class="cover-text">
      <h1 class="cover-title">{titolo}</h1>
      {sottotitolo && <p class="cover-sub">{sottotitolo}</p>}
    </div>
  </div>
  {credit && <figcaption class="cover-credit">Foto: {credit}</figcaption>}
</figure>

<style>
  .cover-articolo { margin: 0 0 28px; padding: 0; }

  /* Nessun aspect-ratio fisso: il contenitore cresce con il titolo.
     Altezza minima garantisce "respiro" visivo; max-height evita che foto
     molto verticali rendano la cover ingestibile. */
  .cover-frame {
    position: relative;
    width: 100%;
    min-height: 320px;
    overflow: hidden;
    border-radius: 10px;
    background: #0b0f14;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  /* Immagine assoluta dietro: object-fit cover + object-position center.
     Non taglia il titolo perche' il titolo e' in un'area dedicata sotto. */
  .cover-frame > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
    display: block;
    z-index: 0;
  }

  /* Gradient che scurisce la parte bassa dove sta il titolo, in modo
     che il bianco sia sempre leggibile indipendentemente dalla foto. */
  .cover-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg,
        rgba(10,14,20,0.35) 0%,
        rgba(10,14,20,0.0) 20%,
        rgba(10,14,20,0.1) 45%,
        rgba(10,14,20,0.75) 72%,
        rgba(10,14,20,0.98) 100%);
    z-index: 1;
  }

  /* Area in alto con categoria + torneo (una riga sola). */
  .cover-top {
    position: relative;
    z-index: 2;
    padding: 18px 22px 0;
  }
  .cover-top .cat {
    display: inline-block;
    font-size: 0.72rem;
    letter-spacing: 2.5px;
    color: #39d453;
    font-weight: 700;
    text-shadow: 0 1px 10px rgba(0,0,0,0.75);
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  /* Riempitivo per spingere il testo verso il basso. */
  .cover-frame > :where(div:nth-of-type(2)) { /* overlay */
    pointer-events: none;
  }

  /* Area testo in basso: cresce quanto serve, il contenitore si adatta. */
  .cover-text {
    position: relative;
    z-index: 2;
    padding: 60px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .cover-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 900;
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.4px;
    color: #ffffff;
    text-shadow: 0 2px 14px rgba(0,0,0,0.85), 0 1px 3px rgba(0,0,0,0.9);
    margin: 0;
    text-wrap: balance;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .cover-sub {
    font-size: 0.95rem;
    color: #e8edf3;
    line-height: 1.4;
    text-shadow: 0 1px 8px rgba(0,0,0,0.85);
    max-width: 60ch;
    margin: 0;
  }
  .cover-credit {
    font-size: 0.72rem;
    color: var(--testo-secondario, #8a94a3);
    margin: 8px 4px 0;
    letter-spacing: 0.3px;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .cover-frame { min-height: 260px; }
    .cover-top { padding: 14px 16px 0; }
    .cover-text { padding: 46px 16px 18px; }
    .cover-title { font-size: clamp(1.1rem, 5.5vw, 1.5rem); }
    .cover-sub { font-size: 0.9rem; }
    .cover-top .cat { font-size: 0.66rem; letter-spacing: 2px; }
  }

  /* Schermi larghi: contenitore piu' alto per bilanciare la foto. */
  @media (min-width: 900px) {
    .cover-frame { min-height: 420px; }
  }
</style>
