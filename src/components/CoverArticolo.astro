---
// Cover articolo: foto reale + titolo in sovraimpressione, gradient per leggibilità.
// Props: cover_image (path pubblico), titolo, torneo, categoria, superficie, sottotitolo opzionale, credit opzionale.
const { cover_image, titolo, torneo, categoria, superficie, sottotitolo, credit } = Astro.props;

const superficeLabel = {
  terra: 'TERRA ROSSA',
  cemento: 'CEMENTO',
  erba: 'ERBA',
  indoor: 'INDOOR'
}[superficie] || 'CEMENTO';
---
<figure class="cover-articolo">
  <div class="cover-frame">
    <img src={cover_image} alt={`${titolo} - ${torneo}`} loading="eager" fetchpriority="high" />
    <div class="cover-overlay"></div>
    <div class="cover-meta-top">
      <span class="cat">{categoria?.toUpperCase()} · {superficeLabel}</span>
      <span class="badge">ANALISITENNIS</span>
    </div>
    <div class="cover-text">
      <div class="cover-torneo">{torneo}</div>
      <h1 class="cover-title">{titolo}</h1>
      {sottotitolo && <p class="cover-sub">{sottotitolo}</p>}
    </div>
  </div>
  {credit && <figcaption class="cover-credit">{credit}</figcaption>}
</figure>

<style>
  .cover-articolo {
    margin: 0 0 32px;
    padding: 0;
  }
  .cover-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 10px;
    background: #000;
    isolation: isolate;
  }
  .cover-frame > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    display: block;
  }
  .cover-overlay {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 72%;
    background: linear-gradient(180deg, rgba(10,14,20,0) 0%, rgba(10,14,20,0.55) 45%, rgba(10,14,20,0.96) 100%);
    z-index: 1;
  }
  .cover-meta-top {
    position: absolute;
    top: 18px;
    left: 24px;
    right: 24px;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .cover-meta-top .cat {
    font-size: 0.72rem;
    letter-spacing: 3px;
    color: #39d453;
    font-weight: 700;
    text-shadow: 0 1px 8px rgba(0,0,0,0.65);
  }
  .cover-meta-top .badge {
    background: rgba(10,14,20,0.72);
    color: #39d453;
    font-size: 0.65rem;
    letter-spacing: 2px;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 999px;
    backdrop-filter: blur(4px);
  }
  .cover-text {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 24px;
    z-index: 2;
  }
  .cover-torneo {
    font-size: 0.78rem;
    color: #cfd6e0;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 8px;
    text-shadow: 0 1px 8px rgba(0,0,0,0.8);
  }
  .cover-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 900;
    font-size: clamp(1.35rem, 3.4vw, 2.4rem);
    line-height: 1.08;
    letter-spacing: -0.5px;
    color: #ffffff;
    text-shadow: 0 2px 16px rgba(0,0,0,0.85), 0 1px 2px rgba(0,0,0,0.9);
    margin: 0 0 10px;
    text-wrap: balance;
  }
  .cover-sub {
    font-size: 0.98rem;
    color: #e8edf3;
    line-height: 1.4;
    text-shadow: 0 1px 8px rgba(0,0,0,0.85);
    max-width: 60ch;
    margin: 0;
  }
  .cover-credit {
    font-size: 0.72rem;
    color: var(--testo-secondario, #8a94a3);
    margin: 8px 2px 0;
    letter-spacing: 0.3px;
  }
  @media (max-width: 480px) {
    .cover-text { left: 18px; right: 18px; bottom: 18px; }
    .cover-meta-top { left: 18px; right: 18px; top: 14px; }
  }
</style>
