---
// Cover articolo: foto reale + titolo in sovraimpressione.
// Regola non negoziabile: il titolo NON viene MAI tagliato, su nessuna larghezza.
// Il contenuto decide l'altezza del contenitore; l'immagine resta clippata nel suo wrapper.
const { cover_image, titolo, torneo, categoria, superficie, sottotitolo, credit } = Astro.props;

const superficeLabel = {
  terra: 'TERRA ROSSA',
  cemento: 'CEMENTO',
  erba: 'ERBA',
  indoor: 'INDOOR'
}[superficie] || 'CEMENTO';
---
<figure class="cover-articolo">
  <div class="cover-frame">
    <div class="cover-image-wrap" aria-hidden="true">
      <img src={cover_image} alt="" loading="eager" fetchpriority="high" />
      <div class="cover-overlay"></div>
    </div>
    <div class="cover-top">
      <span class="cat">{categoria?.toUpperCase()} · {superficeLabel} · {torneo?.toUpperCase()}</span>
    </div>
    <div class="cover-spacer" aria-hidden="true"></div>
    <div class="cover-text">
      <h1 class="cover-title">{titolo}</h1>
      {sottotitolo && <p class="cover-sub">{sottotitolo}</p>}
    </div>
  </div>
  {credit && <figcaption class="cover-credit">Foto: {credit}</figcaption>}
</figure>

<style>
  .cover-articolo { margin: 0 0 28px; padding: 0; }

  /* La frame NON clippa il contenuto. Il titolo e' libero di crescere.
     L'immagine assoluta e il gradient restano confinati nel wrapper figlio. */
  .cover-frame {
    position: relative;
    width: 100%;
    border-radius: 10px;
    background: #0b0f14;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    overflow: visible;
  }

  /* Wrapper che contiene SOLO img + overlay, con overflow:hidden e border-radius */
  .cover-image-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 10px;
    z-index: 0;
    pointer-events: none;
  }
  .cover-image-wrap > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    display: block;
  }
  .cover-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg,
        rgba(10,14,20,0.35) 0%,
        rgba(10,14,20,0.08) 20%,
        rgba(10,14,20,0.15) 42%,
        rgba(10,14,20,0.85) 68%,
        rgba(10,14,20,0.98) 100%);
  }

  /* Riga superiore: categoria + superficie + torneo */
  .cover-top {
    position: relative;
    z-index: 2;
    padding: 18px 22px 0;
    flex-shrink: 0;
  }
  .cover-top .cat {
    display: inline-block;
    font-size: 0.72rem;
    letter-spacing: 2.5px;
    color: #39d453;
    font-weight: 700;
    text-shadow: 0 1px 10px rgba(0,0,0,0.75);
    max-width: 100%;
    overflow-wrap: anywhere;
    line-height: 1.3;
  }

  /* Spacer che si allarga per lasciare respirare l'immagine fra top e testo.
     min-height garantisce che l'immagine sia sempre VISIBILE a sufficienza. */
  .cover-spacer {
    position: relative;
    z-index: 1;
    flex: 1 1 auto;
    min-height: 220px;
    pointer-events: none;
  }

  /* Area testo in basso: cresce con il titolo, nessun overflow possibile. */
  .cover-text {
    position: relative;
    z-index: 2;
    padding: 24px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    flex-shrink: 0;
  }
  .cover-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 900;
    font-size: clamp(1.3rem, 2.6vw, 2rem);
    line-height: 1.14;
    letter-spacing: -0.4px;
    color: #ffffff;
    text-shadow: 0 2px 14px rgba(0,0,0,0.9), 0 1px 3px rgba(0,0,0,0.95);
    margin: 0;
    text-wrap: balance;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .cover-sub {
    font-size: 0.98rem;
    color: #e8edf3;
    line-height: 1.42;
    text-shadow: 0 1px 8px rgba(0,0,0,0.9);
    max-width: 60ch;
    margin: 0;
  }
  .cover-credit {
    font-size: 0.72rem;
    color: var(--testo-secondario, #8a94a3);
    margin: 8px 4px 0;
    letter-spacing: 0.3px;
    line-height: 1.4;
  }

  /* Mobile stretto */
  @media (max-width: 640px) {
    .cover-frame { border-radius: 8px; }
    .cover-image-wrap { border-radius: 8px; }
    .cover-image-wrap > img { object-position: center 38%; }
    .cover-spacer { min-height: 170px; }
    .cover-top { padding: 14px 16px 0; }
    .cover-top .cat {
      font-size: 0.62rem;
      letter-spacing: 1.8px;
    }
    .cover-text { padding: 20px 16px 20px; gap: 8px; }
    .cover-title {
      font-size: clamp(1.15rem, 4.8vw, 1.5rem);
      line-height: 1.18;
    }
    .cover-sub {
      font-size: 0.88rem;
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  @media (max-width: 380px) {
    .cover-spacer { min-height: 150px; }
    .cover-text { padding: 18px 14px 16px; }
    .cover-top { padding: 12px 14px 0; }
    .cover-title { font-size: clamp(1.05rem, 5.3vw, 1.35rem); }
    .cover-sub { font-size: 0.82rem; -webkit-line-clamp: 2; }
  }

  @media (min-width: 900px) {
    .cover-spacer { min-height: 300px; }
    .cover-image-wrap > img { object-position: center 36%; }
  }
</style>
